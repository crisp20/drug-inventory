diff --git a/src/pages/inventory/_components/barcode-confirm-entry.tsx b/src/pages/inventory/_components/barcode-confirm-entry.tsx
new file mode 100644
index 0000000..1368f20
--- /dev/null
+++ b/src/pages/inventory/_components/barcode-confirm-entry.tsx
@@ -0,0 +1,194 @@
+import { useCallback, useRef, useState, type KeyboardEvent } from "react";
+import { CheckCircle2, CircleAlert, Plus, ScanLine } from "lucide-react";
+import { Button } from "@/components/ui/button.tsx";
+import { Input } from "@/components/ui/input.tsx";
+import {
+  AlertDialog,
+  AlertDialogAction,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from "@/components/ui/alert-dialog.tsx";
+import BarcodeScannerDialog from "@/components/barcode-scanner-dialog.tsx";
+import { barcodesMatch, normalizeBarcode } from "@/convex/lib/barcode.ts";
+import { cn } from "@/lib/utils.ts";
+
+type Slot = "first" | "second";
+
+type Props = {
+  existingBarcodes: string[];
+  onAdd: (barcode: string) => void;
+};
+
+// Barcode must be scanned twice and match before a package form can be added.
+// Medicines without a barcode can be added after confirming a reminder.
+export default function BarcodeConfirmEntry({ existingBarcodes, onAdd }: Props) {
+  const [first, setFirst] = useState("");
+  const [second, setSecond] = useState("");
+  const [scanSlot, setScanSlot] = useState<Slot | null>(null);
+  const [askNoBarcode, setAskNoBarcode] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const firstRef = useRef<HTMLInputElement>(null);
+  const secondRef = useRef<HTMLInputElement>(null);
+
+  const bothFilled = first.trim() !== "" && second.trim() !== "";
+  const matched = barcodesMatch(first, second);
+  const isDuplicate =
+    matched && existingBarcodes.some((b) => b && normalizeBarcode(b) === normalizeBarcode(first));
+
+  const reset = () => {
+    setFirst("");
+    setSecond("");
+    setError(null);
+    firstRef.current?.focus();
+  };
+
+  const tryAdd = () => {
+    if (!first.trim()) {
+      setError("Scan the barcode first.");
+      firstRef.current?.focus();
+      return;
+    }
+    if (!second.trim()) {
+      setError("Scan the barcode a second time to confirm.");
+      secondRef.current?.focus();
+      return;
+    }
+    if (!matched) {
+      setError("The two scans do not match. Please scan again.");
+      setSecond("");
+      secondRef.current?.focus();
+      return;
+    }
+    if (isDuplicate) {
+      setError("This barcode is already listed below.");
+      return;
+    }
+    onAdd(first.trim());
+    reset();
+  };
+
+  // Barcode scanners type the code then press Enter; move along instead of submitting the form
+  const onKeyDown = (slot: Slot) => (e: KeyboardEvent<HTMLInputElement>) => {
+    if (e.key !== "Enter") return;
+    e.preventDefault();
+    if (slot === "first" && first.trim()) secondRef.current?.focus();
+    else if (slot === "second") tryAdd();
+  };
+
+  const handleDetected = useCallback(
+    (code: string) => {
+      setError(null);
+      if (scanSlot === "first") {
+        setFirst(code);
+        setTimeout(() => secondRef.current?.focus(), 0);
+      } else {
+        setSecond(code);
+      }
+      setScanSlot(null);
+    },
+    [scanSlot],
+  );
+
+  const scanField = (slot: Slot, value: string, setValue: (v: string) => void, label: string) => (
+    <div className="flex flex-1 gap-1.5">
+      <div className="relative flex-1">
+        <ScanLine className="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-accent-foreground/70" />
+        <Input
+          ref={slot === "first" ? firstRef : secondRef}
+          value={value}
+          onChange={(e) => {
+            setValue(e.target.value);
+            setError(null);
+          }}
+          onKeyDown={onKeyDown(slot)}
+          placeholder={label}
+          aria-label={label}
+          className={cn(
+            "h-11 border-accent-foreground/20 bg-accent pl-9 font-mono text-accent-foreground placeholder:text-accent-foreground/60",
+            bothFilled && matched && !isDuplicate && "border-green-600 dark:border-green-400",
+            bothFilled && !matched && "border-destructive",
+          )}
+        />
+      </div>
+      <Button
+        type="button"
+        variant="secondary"
+        size="icon"
+        className="size-11"
+        onClick={() => setScanSlot(slot)}
+        aria-label={`Use camera for ${label.toLowerCase()}`}
+      >
+        <ScanLine />
+      </Button>
+    </div>
+  );
+
+  return (
+    <div className="space-y-2 rounded-xl border border-dashed p-3">
+      <div className="flex flex-col gap-2 sm:flex-row">
+        {scanField("first", first, setFirst, "Scan barcode")}
+        {scanField("second", second, setSecond, "Scan again to confirm")}
+        <Button type="button" className="h-11" onClick={tryAdd} disabled={!bothFilled}>
+          <Plus /> Add
+        </Button>
+      </div>
+
+      <div className="flex min-h-5 flex-wrap items-center justify-between gap-2 text-xs">
+        {error ? (
+          <span className="flex items-center gap-1 text-destructive">
+            <CircleAlert className="size-3.5" /> {error}
+          </span>
+        ) : bothFilled && matched && !isDuplicate ? (
+          <span className="flex items-center gap-1 font-medium text-green-700 dark:text-green-400">
+            <CheckCircle2 className="size-3.5" /> Barcodes match. Press Add.
+          </span>
+        ) : bothFilled && !matched ? (
+          <span className="flex items-center gap-1 text-destructive">
+            <CircleAlert className="size-3.5" /> The two scans do not match.
+          </span>
+        ) : (
+          <span className="text-muted-foreground">Scan the same barcode twice so we know it was read correctly.</span>
+        )}
+        <button
+          type="button"
+          onClick={() => setAskNoBarcode(true)}
+          className="cursor-pointer font-medium text-primary underline-offset-4 hover:underline"
+        >
+          No barcode?
+        </button>
+      </div>
+
+      <BarcodeScannerDialog
+        open={scanSlot !== null}
+        onOpenChange={(open) => !open && setScanSlot(null)}
+        onDetected={handleDetected}
+      />
+
+      <AlertDialog open={askNoBarcode} onOpenChange={setAskNoBarcode}>
+        <AlertDialogContent>
+          <AlertDialogHeader>
+            <AlertDialogTitle>Add without a barcode?</AlertDialogTitle>
+            <AlertDialogDescription>
+              Please check the packaging carefully. Only continue if this medicine has no barcode or GS1 code. Staff will need to find it by name or Drug ID instead of scanning.
+            </AlertDialogDescription>
+          </AlertDialogHeader>
+          <AlertDialogFooter>
+            <AlertDialogCancel>No, go back</AlertDialogCancel>
+            <AlertDialogAction
+              onClick={() => {
+                onAdd("");
+                reset();
+              }}
+            >
+              Yes, add without barcode
+            </AlertDialogAction>
+          </AlertDialogFooter>
+        </AlertDialogContent>
+      </AlertDialog>
+    </div>
+  );
+}
