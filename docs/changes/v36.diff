diff --git a/src/components/stock/medicine-filter.tsx b/src/components/stock/medicine-filter.tsx
new file mode 100644
index 0000000..a651d93
--- /dev/null
+++ b/src/components/stock/medicine-filter.tsx
@@ -0,0 +1,106 @@
+import { useState } from "react";
+import { useQuery } from "convex/react";
+import { ChevronDown, Pill, X } from "lucide-react";
+import { api } from "@/convex/_generated/api.js";
+import { Button } from "@/components/ui/button.tsx";
+import { Input } from "@/components/ui/input.tsx";
+import {
+  Popover,
+  PopoverContent,
+  PopoverTrigger,
+} from "@/components/ui/popover.tsx";
+import { Spinner } from "@/components/ui/spinner.tsx";
+import { useDebounce } from "@/hooks/use-debounce.ts";
+import type { DrugWithDetails } from "@/lib/drug-types.ts";
+
+type Props = {
+  value: DrugWithDetails | null;
+  onChange: (drug: DrugWithDetails | null) => void;
+};
+
+// Pick one medicine to filter by (search by name, brand, Drug ID or barcode)
+export default function MedicineFilter({ value, onChange }: Props) {
+  const [open, setOpen] = useState(false);
+  const [text, setText] = useState("");
+  const [term] = useDebounce(text.trim(), 200);
+  // Only search while the picker is open
+  const results = useQuery(api.drugs.search, open && term ? { term } : "skip");
+
+  const pick = (drug: DrugWithDetails | null) => {
+    onChange(drug);
+    setOpen(false);
+    setText("");
+  };
+
+  return (
+    <div className="flex items-center gap-1">
+      <Popover open={open} onOpenChange={setOpen}>
+        <PopoverTrigger asChild>
+          <Button
+            type="button"
+            variant="secondary"
+            size="sm"
+            className="h-9 max-w-56 justify-between gap-2 font-normal"
+          >
+            <Pill className="size-4 shrink-0" />
+            <span className="truncate">
+              {value ? value.name : "All medicines"}
+            </span>
+            <ChevronDown className="size-4 shrink-0 opacity-50" />
+          </Button>
+        </PopoverTrigger>
+        <PopoverContent align="start" className="w-80 space-y-2 p-2">
+          <Input
+            autoFocus
+            value={text}
+            onChange={(e) => setText(e.target.value)}
+            placeholder="Search name, brand or Drug ID"
+            className="h-9"
+          />
+          <div className="max-h-64 overflow-y-auto">
+            {!term ? (
+              <p className="px-2 py-3 text-sm text-muted-foreground">
+                Type to find a medicine
+              </p>
+            ) : results === undefined ? (
+              <div className="flex justify-center py-3">
+                <Spinner />
+              </div>
+            ) : results.length === 0 ? (
+              <p className="px-2 py-3 text-sm text-muted-foreground">
+                No medicine matches “{term}”
+              </p>
+            ) : (
+              results.map((d) => (
+                <button
+                  key={d._id}
+                  type="button"
+                  onClick={() => pick(d)}
+                  className="flex w-full cursor-pointer flex-col items-start rounded-md px-2 py-1.5 text-left hover:bg-muted"
+                >
+                  <span className="text-sm font-medium">{d.name}</span>
+                  <span className="text-xs text-muted-foreground">
+                    {d.brandName} ·{" "}
+                    <span className="font-mono">{d.drugId}</span>
+                  </span>
+                </button>
+              ))
+            )}
+          </div>
+        </PopoverContent>
+      </Popover>
+      {value && (
+        <Button
+          type="button"
+          variant="ghost"
+          size="icon"
+          className="size-8"
+          onClick={() => pick(null)}
+          aria-label="Clear medicine filter"
+        >
+          <X className="size-4" />
+        </Button>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/stock/movement-filter-bar.tsx b/src/components/stock/movement-filter-bar.tsx
new file mode 100644
index 0000000..a0cd7e8
--- /dev/null
+++ b/src/components/stock/movement-filter-bar.tsx
@@ -0,0 +1,168 @@
+import { useQuery } from "convex/react";
+import { RotateCcw } from "lucide-react";
+import { api } from "@/convex/_generated/api.js";
+import type { Id } from "@/convex/_generated/dataModel.d.ts";
+import { formatPackageForm } from "@/convex/lib/barcode.ts";
+import { STOCK_OUT_REASONS, type MovementKind } from "@/convex/lib/stock.ts";
+import { Button } from "@/components/ui/button.tsx";
+import { Input } from "@/components/ui/input.tsx";
+import {
+  NativeSelect,
+  NativeSelectOption,
+} from "@/components/ui/native-select.tsx";
+import type { DrugWithDetails } from "@/lib/drug-types.ts";
+import MedicineFilter from "./medicine-filter.tsx";
+import { PERIODS, type Period } from "./movement-period.ts";
+
+export type MovementFilters = {
+  period: Period;
+  userId: Id<"users"> | "all";
+  reason: string;
+  medicine: DrugWithDetails | null;
+  packageId: Id<"drugPackages"> | "all";
+};
+
+type Props = {
+  kind: MovementKind;
+  value: MovementFilters;
+  onChange: (next: MovementFilters) => void;
+  onReset: () => void;
+  isFiltered: boolean;
+};
+
+const selectClass = "h-9 cursor-pointer bg-card";
+
+// Time period, user, medicine, package form and (Stock Out) reason filters
+export default function MovementFilterBar({
+  kind,
+  value,
+  onChange,
+  onReset,
+  isFiltered,
+}: Props) {
+  const people = useQuery(api.users.listPeople, {});
+  const set = (patch: Partial<MovementFilters>) =>
+    onChange({ ...value, ...patch });
+  const { period, medicine } = value;
+
+  return (
+    <div className="space-y-2 rounded-xl border bg-muted/40 p-2">
+      <div className="flex flex-wrap items-center gap-2">
+        <NativeSelect
+          aria-label="Time period"
+          className={selectClass}
+          value={period.value}
+          onChange={(e) => {
+            const next = PERIODS.find((p) => p.value === e.target.value);
+            if (next) set({ period: { ...period, value: next.value } });
+          }}
+        >
+          {PERIODS.map((p) => (
+            <NativeSelectOption key={p.value} value={p.value}>
+              {p.label}
+            </NativeSelectOption>
+          ))}
+        </NativeSelect>
+
+        <NativeSelect
+          aria-label="User"
+          className={selectClass}
+          value={value.userId}
+          onChange={(e) => {
+            const id = people?.find((p) => p._id === e.target.value)?._id;
+            set({ userId: id ?? "all" });
+          }}
+        >
+          <NativeSelectOption value="all">Everyone</NativeSelectOption>
+          {(people ?? []).map((p) => (
+            <NativeSelectOption key={p._id} value={p._id}>
+              {p.name}
+            </NativeSelectOption>
+          ))}
+        </NativeSelect>
+
+        <MedicineFilter
+          value={medicine}
+          onChange={(drug) => set({ medicine: drug, packageId: "all" })}
+        />
+
+        {medicine && medicine.packages.length > 0 && (
+          <NativeSelect
+            aria-label="Package form"
+            className={selectClass}
+            value={value.packageId}
+            onChange={(e) => {
+              const id = medicine.packages.find(
+                (p) => p._id === e.target.value,
+              )?._id;
+              set({ packageId: id ?? "all" });
+            }}
+          >
+            <NativeSelectOption value="all">
+              All package forms
+            </NativeSelectOption>
+            {medicine.packages.map((p) => (
+              <NativeSelectOption key={p._id} value={p._id}>
+                {formatPackageForm(p)}
+              </NativeSelectOption>
+            ))}
+          </NativeSelect>
+        )}
+
+        {kind === "out" && (
+          <NativeSelect
+            aria-label="Reason"
+            className={selectClass}
+            value={value.reason}
+            onChange={(e) => set({ reason: e.target.value })}
+          >
+            <NativeSelectOption value="all">All reasons</NativeSelectOption>
+            {STOCK_OUT_REASONS.map((r) => (
+              <NativeSelectOption key={r} value={r}>
+                {r}
+              </NativeSelectOption>
+            ))}
+          </NativeSelect>
+        )}
+
+        {isFiltered && (
+          <Button
+            type="button"
+            variant="ghost"
+            size="sm"
+            className="h-9 gap-1.5"
+            onClick={onReset}
+          >
+            <RotateCcw className="size-3.5" />
+            Clear filters
+          </Button>
+        )}
+      </div>
+
+      {period.value === "custom" && (
+        <div className="flex flex-wrap items-center gap-2 text-sm">
+          <span className="text-muted-foreground">From</span>
+          <Input
+            type="date"
+            aria-label="From date"
+            className="h-9 w-auto bg-card"
+            value={period.from}
+            max={period.to || undefined}
+            onChange={(e) =>
+              set({ period: { ...period, from: e.target.value } })
+            }
+          />
+          <span className="text-muted-foreground">to</span>
+          <Input
+            type="date"
+            aria-label="To date"
+            className="h-9 w-auto bg-card"
+            value={period.to}
+            min={period.from || undefined}
+            onChange={(e) => set({ period: { ...period, to: e.target.value } })}
+          />
+        </div>
+      )}
+    </div>
+  );
+}
