index 0000000..637e783
--- /dev/null
+++ b/src/components/zoomable-drug-image.tsx
@@ -0,0 +1,36 @@
+import { useState } from "react";
+import { ZoomIn } from "lucide-react";
+import { Dialog, DialogContent, DialogDescription, DialogTitle } from "@/components/ui/dialog.tsx";
+import { cn } from "@/lib/utils.ts";
+import DrugImage from "./drug-image.tsx";
+
+type Props = { url: string | null | undefined; alt: string; className?: string };
+
+// Drug picture thumbnail that opens a large view when pressed
+export default function ZoomableDrugImage({ url, alt, className }: Props) {
+  const [open, setOpen] = useState(false);
+  if (!url) return <DrugImage url={null} alt={alt} className={cn("shrink-0", className)} />;
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={() => setOpen(true)}
+        className={cn("group relative shrink-0 cursor-zoom-in overflow-hidden rounded-lg", className)}
+        aria-label={`Enlarge picture of ${alt}`}
+      >
+        <DrugImage url={url} alt={alt} className="size-full transition-transform group-hover:scale-105" />
+        <span className="absolute bottom-1 right-1 flex size-6 items-center justify-center rounded-full bg-black/55 text-white">
+          <ZoomIn className="size-3.5" />
+        </span>
+      </button>
+      <Dialog open={open} onOpenChange={setOpen}>
+        <DialogContent className="max-w-[calc(100vw-2rem)] gap-3 p-3 sm:max-w-2xl">
+          <DialogTitle className="pr-8 text-base">{alt}</DialogTitle>
+          <DialogDescription className="sr-only">Enlarged drug picture</DialogDescription>
+          <img src={url} alt={alt} className="max-h-[75vh] w-full rounded-lg bg-muted object-contain" />
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
