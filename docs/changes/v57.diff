+import { useWatch, type Control } from "react-hook-form";
+import { TriangleAlert } from "lucide-react";
+import type { Id } from "@/convex/_generated/dataModel.d.ts";
+import { FormControl, FormField, FormItem, FormLabel } from "@/components/ui/form.tsx";
+import { Switch } from "@/components/ui/switch.tsx";
+import type { DrugFormInput, DrugFormValues } from "../_lib/drug-form-schema.ts";
+import LookAlikePicker from "./look-alike-picker.tsx";
+
+type Props = {
+  control: Control<DrugFormInput, unknown, DrugFormValues>;
+  selfId?: Id<"drugs">;
+};
+
+// Look Alike, Sound Alike switch, and the linked similar drugs once switched on
+export default function LasaFields({ control, selfId }: Props) {
+  const lasa = useWatch({ control, name: "lasa" });
+  return (
+    <div className="space-y-3 rounded-xl border border-destructive/25 bg-destructive/5 p-4">
+      <FormField
+        control={control}
+        name="lasa"
+        render={({ field }) => (
+          <FormItem className="flex items-start justify-between gap-4">
+            <div className="space-y-1">
+              <FormLabel className="flex items-center gap-2">
+                <TriangleAlert className="size-4 text-destructive" /> Look Alike, Sound Alike
+              </FormLabel>
+              <p className="text-xs text-muted-foreground">
+                Staff are warned to double-check the pictures whenever this drug is chosen.
+              </p>
+            </div>
+            <FormControl>
+              <Switch checked={field.value} onCheckedChange={field.onChange} className="cursor-pointer" />
+            </FormControl>
+          </FormItem>
+        )}
+      />
+      {lasa && (
+        <FormField
+          control={control}
+          name="lookAlikes"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel>Looks or sounds like</FormLabel>
+              <p className="text-xs text-muted-foreground">
+                Linked drugs are marked too and show each other in the warning.
+              </p>
+              <LookAlikePicker selfId={selfId} value={field.value} onChange={field.onChange} />
+            </FormItem>
+          )}
+        />
+      )}
+    </div>
+  );
+}
diff --git a/src/pages/inventory/_components/look-alike-picker.tsx b/src/pages/inventory/_components/look-alike-picker.tsx
new file mode 100644
--- /dev/null
+++ b/src/pages/inventory/_components/look-alike-picker.tsx
@@ -0,0 +1,93 @@
+import { useState } from "react";
+import { useQuery } from "convex/react";
+import { Plus, X } from "lucide-react";
+import { api } from "@/convex/_generated/api.js";
+import type { Id } from "@/convex/_generated/dataModel.d.ts";
+import { Input } from "@/components/ui/input.tsx";
+import { Spinner } from "@/components/ui/spinner.tsx";
+import { useDebounce } from "@/hooks/use-debounce.ts";
+
+export type LookAlikeOption = { _id: Id<"drugs">; drugId: string; name: string; brandName: string };
+
+type Props = {
+  // The drug being edited (left out of the results); undefined when adding a new drug
+  selfId?: Id<"drugs">;
+  value: LookAlikeOption[];
+  onChange: (value: LookAlikeOption[]) => void;
+};
+
+const MAX_LINKS = 20;
+
+// Search and link the drugs this one looks or sounds like
+export default function LookAlikePicker({ selfId, value, onChange }: Props) {
+  const [search, setSearch] = useState("");
+  const [term] = useDebounce(search.trim(), 250);
+  const results = useQuery(api.drugs.search, term ? { term } : "skip");
+  const chosen = new Set(value.map((d) => d._id));
+  const options = (results ?? []).filter((d) => d._id !== selfId && !chosen.has(d._id)).slice(0, 8);
+
+  const add = (d: LookAlikeOption) => {
+    onChange([...value, { _id: d._id, drugId: d.drugId, name: d.name, brandName: d.brandName }]);
+    setSearch("");
+  };
+
+  return (
+    <div className="space-y-2">
+      {value.length > 0 && (
+        <div className="flex flex-wrap gap-2">
+          {value.map((d) => (
+            <span
+              key={d._id}
+              className="inline-flex max-w-full items-center gap-1 rounded-full border bg-secondary py-1 pl-3 pr-1 text-xs"
+            >
+              <span className="truncate font-medium">{d.name}</span>
+              <span className="font-mono text-muted-foreground">{d.drugId}</span>
+              <button
+                type="button"
+                onClick={() => onChange(value.filter((x) => x._id !== d._id))}
+                className="cursor-pointer rounded-full p-0.5 text-muted-foreground hover:bg-muted hover:text-foreground"
+                aria-label={`Remove ${d.name}`}
+              >
+                <X className="size-3.5" />
+              </button>
+            </span>
+          ))}
+        </div>
+      )}
+      {value.length < MAX_LINKS && (
+        <Input
+          value={search}
+          onChange={(e) => setSearch(e.target.value)}
+          placeholder="Search a similar drug by name, brand or Drug ID"
+        />
+      )}
+      {term && (
+        <div className="max-h-56 overflow-y-auto rounded-lg border">
+          {results === undefined ? (
+            <div className="flex justify-center p-3">
+              <Spinner />
+            </div>
+          ) : options.length === 0 ? (
+            <p className="p-3 text-sm text-muted-foreground">No other drugs match “{term}”.</p>
+          ) : (
+            options.map((d) => (
+              <button
+                key={d._id}
+                type="button"
+                onClick={() => add(d)}
+                className="flex w-full cursor-pointer items-center gap-2 border-b px-3 py-2 text-left text-sm last:border-b-0 hover:bg-muted"
+              >
+                <Plus className="size-4 shrink-0 text-primary" />
+                <span className="min-w-0 flex-1 truncate">
+                  <span className="font-medium">{d.name}</span>
+                  {d.brandName && <span className="text-muted-foreground"> · {d.brandName}</span>}
+                </span>
+                <span className="font-mono text-xs text-muted-foreground">{d.drugId}</span>
+              </button>
+            ))
+          )}
+        </div>
+      )}
+    </div>
+  );
+}