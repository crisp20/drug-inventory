diff --git a/src/pages/inventory/_components/package-history-dialog.tsx b/src/pages/inventory/_components/package-history-dialog.tsx
new file mode 100644
index 0000000..a23e128
--- /dev/null
+++ b/src/pages/inventory/_components/package-history-dialog.tsx
@@ -0,0 +1,59 @@
+import { formatPackageForm } from "@/convex/lib/barcode.ts";
+import MovementLog from "@/components/stock/movement-log.tsx";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog.tsx";
+import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs.tsx";
+import type { DrugPackage, DrugWithDetails } from "@/lib/drug-types.ts";
+
+type Props = {
+  drug: DrugWithDetails;
+  pkg: DrugPackage | null;
+  onClose: () => void;
+};
+
+// Every Stock In and Stock Out recorded against one package form (barcode)
+export default function PackageHistoryDialog({ drug, pkg, onClose }: Props) {
+  return (
+    <Dialog open={!!pkg} onOpenChange={(o) => !o && onClose()}>
+      <DialogContent className="flex max-h-[90vh] flex-col gap-4 sm:max-w-2xl">
+        {pkg && (
+          <>
+            <DialogHeader>
+              <DialogTitle>
+                {drug.name} · {formatPackageForm(pkg)}
+              </DialogTitle>
+              <DialogDescription>
+                {pkg.barcode ? <span className="font-mono">{pkg.barcode}</span> : "No barcode"} · {pkg.stock} in
+                stock
+              </DialogDescription>
+            </DialogHeader>
+            {/* Inactive tabs unmount, so only one list is loaded at a time */}
+            <Tabs defaultValue="all" className="min-h-0 flex-1">
+              <TabsList className="grid w-full grid-cols-3">
+                <TabsTrigger value="all" className="cursor-pointer">All</TabsTrigger>
+                <TabsTrigger value="in" className="cursor-pointer">Stock In</TabsTrigger>
+                <TabsTrigger value="out" className="cursor-pointer">Stock Out</TabsTrigger>
+              </TabsList>
+              <div className="min-h-0 flex-1 overflow-y-auto pt-2">
+                <TabsContent value="all">
+                  <MovementLog filter={{ type: "package", packageId: pkg._id }} />
+                </TabsContent>
+                <TabsContent value="in">
+                  <MovementLog kind="in" filter={{ type: "package", packageId: pkg._id }} />
+                </TabsContent>
+                <TabsContent value="out">
+                  <MovementLog kind="out" filter={{ type: "package", packageId: pkg._id }} />
+                </TabsContent>
+              </div>
+            </Tabs>
+          </>
+        )}
+      </DialogContent>
+    </Dialog>
+  );
+}
