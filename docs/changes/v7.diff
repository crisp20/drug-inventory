+import type { MovementKind } from "@/convex/lib/stock.ts";
+import PageHeader from "@/components/page-header.tsx";
+import MovementForm from "./movement-form.tsx";
+import MovementLog from "./movement-log.tsx";
+import StockDrugFinder from "./stock-drug-finder.tsx";
+
+const COPY = {
+  in: {
+    title: "Stock In",
+    description: "Scan or search a drug, choose the package form, and record what arrived.",
+    logTitle: "Recent Stock In",
+  },
+  out: {
+    title: "Stock Out",
+    description: "Scan or search a drug, choose the package form, and record what is going out.",
+    logTitle: "Recent Stock Out",
+  },
+} as const;
+
+// Shared page layout for Stock In and Stock Out
+export default function StockMovementPage({ kind }: { kind: MovementKind }) {
+  const copy = COPY[kind];
+  return (
+    <div className="mx-auto max-w-3xl space-y-10 p-4 md:p-8">
+      <div>
+        <PageHeader title={copy.title} description={copy.description} />
+        <StockDrugFinder key={kind}>
+          {(selection, reset) => (
+            <MovementForm key={selection.pkg._id} kind={kind} selection={selection} onDone={reset} />
+          )}
+        </StockDrugFinder>
+      </div>
+      <section className="space-y-3">
+        <h2 className="text-lg font-bold">{copy.logTitle}</h2>
+        <MovementLog kind={kind} />
+      </section>
+    </div>
+  );
+}
