+import { useForm, useWatch } from "react-hook-form";
+import { zodResolver } from "@hookform/resolvers/zod";
+import { useMutation } from "convex/react";
+import { ArrowDownToLine, ArrowUpFromLine } from "lucide-react";
+import { toast } from "sonner";
+import { api } from "@/convex/_generated/api.js";
+import { formatPackageForm } from "@/convex/lib/barcode.ts";
+import { DEFAULT_STOCK_OUT_REASON, type MovementKind } from "@/convex/lib/stock.ts";
+import { Button } from "@/components/ui/button.tsx";
+import { Form, FormControl, FormField, FormItem, FormLabel, FormMessage } from "@/components/ui/form.tsx";
+import { Input } from "@/components/ui/input.tsx";
+import { Spinner } from "@/components/ui/spinner.tsx";
+import { Textarea } from "@/components/ui/textarea.tsx";
+import { errorMessage } from "@/lib/errors.ts";
+import { cn } from "@/lib/utils.ts";
+import { movementFormSchema, type MovementFormInput, type MovementFormValues } from "./movement-form-schema.ts";
+import PackageFormSummary from "./package-form-summary.tsx";
+import ReasonField from "./reason-field.tsx";
+import type { StockSelection } from "./stock-drug-finder.tsx";
+
+type Props = { kind: MovementKind; selection: StockSelection; onDone: () => void };
+
+const COPY = {
+  in: {
+    title: "Stock In",
+    quantityLabel: "Quantity received",
+    notesPlaceholder: "e.g. Invoice #4521 from supplier",
+    submit: "Record Stock In",
+    verb: "Added",
+    error: "Could not record Stock In",
+    icon: ArrowDownToLine,
+  },
+  out: {
+    title: "Stock Out",
+    quantityLabel: "Quantity going out",
+    notesPlaceholder: "e.g. Patient / ward / script number",
+    submit: "Record Stock Out",
+    verb: "Removed",
+    error: "Could not record Stock Out",
+    icon: ArrowUpFromLine,
+  },
+} as const;
+
+function toNumber(value: string | number | undefined): number {
+  const n = Number(value);
+  return Number.isFinite(n) ? n : 0;
+}
+
+// Quantity, editable package form, notes (and reason for Stock Out) for one package form
+export default function MovementForm({ kind, selection, onDone }: Props) {
+  const { drug, pkg } = selection;
+  const copy = COPY[kind];
+  const recordIn = useMutation(api.stock.recordIn);
+  const recordOut = useMutation(api.stock.recordOut);
+  const form = useForm<MovementFormInput, unknown, MovementFormValues>({
+    resolver: zodResolver(movementFormSchema(kind)),
+    defaultValues: {
+      quantity: 1,
+      notes: "",
+      reason: kind === "out" ? DEFAULT_STOCK_OUT_REASON : "",
+    },
+  });
+  const watched = useWatch({ control: form.control });
+  const quantity = Math.max(0, toNumber(watched.quantity));
+  const stockAfter = kind === "in" ? pkg.stock + quantity : pkg.stock - quantity;
+  const notEnough = kind === "out" && stockAfter < 0;
+
+  const onSubmit = async ({ reason, ...values }: MovementFormValues) => {
+    try {
+      const args = { packageId: pkg._id, ...values };
+      const result = kind === "in" ? await recordIn(args) : await recordOut({ ...args, reason });
+      toast.success(`${copy.verb} ${values.quantity} × ${formatPackageForm(pkg)} of ${drug.name}`, {
+        description: `Stock is now ${result.stockAfter}`,
+      });
+      onDone();
+    } catch (e) {
+      toast.error(errorMessage(e, copy.error));
+    }
+  };
+
+  return (
+    <Form {...form}>
+      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-5 rounded-xl border-2 border-primary/30 bg-card p-4">
+        <div className="flex items-baseline justify-between gap-3">
+          <h2 className="text-lg font-bold">{copy.title}</h2>
+          <span className="truncate text-sm text-muted-foreground">{drug.name}</span>
+        </div>
+
+        <FormField
+          control={form.control}
+          name="quantity"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel>{copy.quantityLabel}</FormLabel>
+              <FormControl>
+                <Input
+                  {...field}
+                  value={String(field.value)}
+                  inputMode="numeric"
+                  autoFocus
+                  onFocus={(e) => e.target.select()}
+                  className="h-14 bg-background text-center text-2xl font-extrabold"
+                />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+
+        <PackageFormSummary pkg={pkg} pieceName={drug.pieceName} />
+
+        {kind === "out" && <ReasonField control={form.control} />}
+
+        <FormField
+          control={form.control}
+          name="notes"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel>Notes</FormLabel>
+              <FormControl>
+                <Textarea {...field} rows={2} placeholder={copy.notesPlaceholder} className="bg-background" />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+
+        <div
+          className={cn(
+            "flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm",
+            notEnough ? "bg-destructive/10 text-destructive" : "bg-muted",
+          )}
+        >
+          <span className={cn(!notEnough && "text-muted-foreground")}>
+            {notEnough ? `Not enough stock: only ${pkg.stock} on hand` : "Stock after"}
+          </span>
+          <span className="font-semibold">
+            {pkg.stock} → <span className="text-lg font-extrabold">{stockAfter}</span>
+          </span>
+        </div>
+
+        <div className="flex gap-2">
+          <Button type="button" variant="ghost" onClick={onDone}>
+            Cancel
+          </Button>
+          <Button type="submit" size="lg" className="flex-1" disabled={form.formState.isSubmitting || notEnough}>
+            {form.formState.isSubmitting ? <Spinner /> : <copy.icon />}
+            {copy.submit}
+          </Button>
+        </div>
+      </form>
+    </Form>
+  );
+}
