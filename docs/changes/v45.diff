+
+  it("still uses separators when they are sent", () => {
+    expect(
+      parseGs1(
+        "0104897133761542\u001d2110304962804256\u001d10RC4304\u001d17281100",
+      ),
+    ).toEqual({
+      gtin: "04897133761542",
+      batch: "RC4304",
+      expiry: "2028-11-30",
+    });
+  });
