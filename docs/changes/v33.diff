diff --git a/src/hooks/use-scan-guard.test.ts b/src/hooks/use-scan-guard.test.ts
new file mode 100644
index 0000000..4509af0
--- /dev/null
+++ b/src/hooks/use-scan-guard.test.ts
@@ -0,0 +1,85 @@
+import type { KeyboardEvent } from "react";
+import { act, renderHook } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { useScanGuard } from "./use-scan-guard.ts";
+
+type FakeKey = { code: string; key: string; timeStamp: number; value: string };
+
+// Minimal keydown event with just what the guard reads
+function keyEvent({ code, key, timeStamp, value }: FakeKey) {
+  const preventDefault = vi.fn();
+  const target = { value, blur: vi.fn() };
+  const event = {
+    code,
+    key,
+    timeStamp,
+    shiftKey: false,
+    ctrlKey: false,
+    getModifierState: () => false,
+    currentTarget: target,
+    preventDefault,
+  };
+  return {
+    event: event as unknown as KeyboardEvent<HTMLInputElement>,
+    preventDefault,
+  };
+}
+
+function digits(text: string, gapMs: number, value: string) {
+  return [...text].map((d, i) =>
+    keyEvent({ code: `Digit${d}`, key: d, timeStamp: 1000 + i * gapMs, value }),
+  );
+}
+
+describe("useScanGuard", () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => vi.useRealTimers());
+
+  it("blocks a scan in the quantity box, including its Enter, and restores the old value", () => {
+    const onBlocked = vi.fn();
+    const { result } = renderHook(() => useScanGuard(onBlocked));
+    const keys = digits("010185742", 5, "12");
+    keys.forEach(({ event }) => result.current(event));
+    // First keys can't be told apart from typing; later ones are blocked
+    expect(keys[0].preventDefault).not.toHaveBeenCalled();
+    expect(keys[8].preventDefault).toHaveBeenCalled();
+
+    const enter = keyEvent({
+      code: "Enter",
+      key: "Enter",
+      timeStamp: 1050,
+      value: "01018",
+    });
+    act(() => result.current(enter.event));
+    expect(enter.preventDefault).toHaveBeenCalled();
+    expect(onBlocked).toHaveBeenCalledWith("12");
+  });
+
+  it("lets a person type a quantity and press Enter", () => {
+    const onBlocked = vi.fn();
+    const { result } = renderHook(() => useScanGuard(onBlocked));
+    const keys = digits("150", 200, "1");
+    keys.forEach(({ event }) => result.current(event));
+    const enter = keyEvent({
+      code: "Enter",
+      key: "Enter",
+      timeStamp: 2000,
+      value: "150",
+    });
+    act(() => result.current(enter.event));
+    act(() => vi.runAllTimers());
+    expect(keys.some((k) => k.preventDefault.mock.calls.length > 0)).toBe(
+      false,
+    );
+    expect(enter.preventDefault).not.toHaveBeenCalled();
+    expect(onBlocked).not.toHaveBeenCalled();
+  });
+
+  it("restores after a scan that ends without Enter", () => {
+    const onBlocked = vi.fn();
+    const { result } = renderHook(() => useScanGuard(onBlocked));
+    digits("85742000", 5, "3").forEach(({ event }) => result.current(event));
+    act(() => vi.runAllTimers());
+    expect(onBlocked).toHaveBeenCalledWith("3");
+  });
+});
diff --git a/src/hooks/use-scan-guard.ts b/src/hooks/use-scan-guard.ts
new file mode 100644
index 0000000..c71aaee
--- /dev/null
+++ b/src/hooks/use-scan-guard.ts
@@ -0,0 +1,75 @@
+import { useCallback, useEffect, useRef, type KeyboardEvent } from "react";
+import {
+  SCAN_END_MS,
+  addKey,
+  isModifierCode,
+  keyFromCode,
+  scanResult,
+  type Burst,
+} from "@/lib/scanner-input.ts";
+
+// For boxes meant for typing by hand (e.g. quantity). If scanner-speed typing arrives,
+// further keys (including the scanner's Enter) are blocked, and once the burst ends
+// `onBlocked` gets the value the box had before the scan so it can be put back.
+export function useScanGuard(onBlocked: (valueBefore: string) => void) {
+  const burstRef = useRef<Burst | null>(null);
+  const timerRef = useRef<number | undefined>(undefined);
+  const blockedRef = useRef(false);
+  const inputRef = useRef<HTMLInputElement | null>(null);
+
+  useEffect(() => () => window.clearTimeout(timerRef.current), []);
+
+  const end = useCallback(() => {
+    window.clearTimeout(timerRef.current);
+    const burst = burstRef.current;
+    const blocked = blockedRef.current;
+    burstRef.current = null;
+    blockedRef.current = false;
+    if (!blocked || !burst) return;
+    // Ends any half-typed Chinese word so it can't land in the box afterwards
+    inputRef.current?.blur();
+    onBlocked(burst.prefix);
+  }, [onBlocked]);
+
+  return useCallback(
+    (e: KeyboardEvent<HTMLInputElement>) => {
+      inputRef.current = e.currentTarget;
+      const isEnter =
+        e.code === "Enter" || e.code === "NumpadEnter" || e.key === "Enter";
+      if (isEnter) {
+        // Stop the scanner's Enter from submitting the scanned number
+        if (blockedRef.current) {
+          e.preventDefault();
+          end();
+        }
+        return;
+      }
+      if (isModifierCode(e.code)) return;
+      const char =
+        e.code === ""
+          ? null
+          : keyFromCode(e.code, {
+              shift: e.shiftKey,
+              ctrl: e.ctrlKey,
+              capsLock: e.getModifierState("CapsLock"),
+            });
+      if (char === null && e.code !== "") {
+        burstRef.current = null;
+        return;
+      }
+      burstRef.current = addKey(
+        burstRef.current,
+        char,
+        e.timeStamp,
+        e.currentTarget.value,
+      );
+      if (scanResult(burstRef.current)) {
+        blockedRef.current = true;
+        e.preventDefault();
+      }
+      window.clearTimeout(timerRef.current);
+      timerRef.current = window.setTimeout(end, SCAN_END_MS);
+    },
+    [end],
+  );
+}
