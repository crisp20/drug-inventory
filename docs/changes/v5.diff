+import { defineTable } from "convex/server";
+import { v } from "convex/values";
+import { baseUnit } from "./drugs";
+
+export const movementKind = v.union(v.literal("in"), v.literal("out"));
+
+// Append-only log of every stock change. Drug, barcode and user details are
+// copied in so the history still reads correctly after a drug is edited or deleted.
+export const stockMovementsTable = defineTable({
+  kind: movementKind,
+  drugRef: v.id("drugs"),
+  packageRef: v.id("drugPackages"),
+  drugCode: v.string(),
+  drugName: v.string(),
+  brandName: v.string(),
+  pieceName: v.string(),
+  barcode: v.string(),
+  // Package form as recorded by the user (prefilled from the barcode, editable)
+  qtyPerUnit: v.number(),
+  baseUnit: baseUnit,
+  unitCount: v.number(),
+  // True when the recorded form differs from the barcode's saved form
+  formChanged: v.boolean(),
+  // Number of package forms moved
+  quantity: v.number(),
+  stockBefore: v.number(),
+  stockAfter: v.number(),
+  notes: v.string(),
+  // Stock Out only (e.g. "Dispensed")
+  reason: v.optional(v.string()),
+  userRef: v.id("users"),
+  userName: v.string(),
+  occurredAt: v.string(),
+})
+  .index("by_kind_and_occurredAt", ["kind", "occurredAt"])
+  .index("by_drug_and_occurredAt", ["drugRef", "occurredAt"]);
