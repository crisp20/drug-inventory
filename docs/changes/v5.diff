+import { z } from "zod";
+import { BASE_UNITS } from "@/convex/lib/barcode.ts";
+import { MAX_MOVEMENT_QUANTITY, MAX_NOTES_LENGTH } from "@/convex/lib/stock.ts";
+
+const positiveInt = (label: string, max?: number) => {
+  const base = z.coerce.number<string | number>().int(`${label} must be a whole number`).min(1, `${label} must be at least 1`);
+  return max ? base.max(max, `${label} can be at most ${max.toLocaleString()}`) : base;
+};
+
+// Shared by Stock In and Stock Out forms
+export const movementFormSchema = z.object({
+  quantity: positiveInt("Quantity", MAX_MOVEMENT_QUANTITY),
+  qtyPerUnit: positiveInt("Qty per unit"),
+  baseUnit: z.enum(BASE_UNITS),
+  unitCount: positiveInt("No. of units"),
+  notes: z.string().trim().max(MAX_NOTES_LENGTH, `Notes can be at most ${MAX_NOTES_LENGTH} characters`),
+});
+
+export type MovementFormInput = z.input<typeof movementFormSchema>;
+export type MovementFormValues = z.output<typeof movementFormSchema>;
