+import { paginationOptsValidator } from "convex/server";
+import { ConvexError, v } from "convex/values";
+import { mutation, query } from "./_generated/server";
+import { requireActiveUser } from "./lib/access";
+import { cleanMovementInput, formDiffers, nextStock } from "./lib/stock";
+import { baseUnit } from "./schema/drugs";
+import { movementKind } from "./schema/stock";
+
+// Records stock received. Any approved user (admin or staff) can do this.
+export const recordIn = mutation({
+  args: {
+    packageId: v.id("drugPackages"),
+    quantity: v.number(),
+    qtyPerUnit: v.number(),
+    baseUnit: baseUnit,
+    unitCount: v.number(),
+    notes: v.string(),
+  },
+  handler: async (ctx, { packageId, ...rest }) => {
+    const user = await requireActiveUser(ctx);
+    const input = cleanMovementInput(rest);
+    const pkg = await ctx.db.get("drugPackages", packageId);
+    if (!pkg) throw new ConvexError({ code: "NOT_FOUND", message: "This package form no longer exists" });
+    const drug = await ctx.db.get("drugs", pkg.drugRef);
+    if (!drug) throw new ConvexError({ code: "NOT_FOUND", message: "This drug no longer exists" });
+
+    const stockAfter = nextStock(pkg.stock, "in", input.quantity);
+    await ctx.db.patch("drugPackages", pkg._id, { stock: stockAfter });
+    await ctx.db.insert("stockMovements", {
+      kind: "in",
+      drugRef: drug._id,
+      packageRef: pkg._id,
+      drugCode: drug.drugId,
+      drugName: drug.name,
+      brandName: drug.brandName,
+      pieceName: drug.pieceName,
+      barcode: pkg.barcode,
+      qtyPerUnit: input.qtyPerUnit,
+      baseUnit: input.baseUnit,
+      unitCount: input.unitCount,
+      formChanged: formDiffers(pkg, input),
+      quantity: input.quantity,
+      stockBefore: pkg.stock,
+      stockAfter,
+      notes: input.notes,
+      userRef: user._id,
+      userName: user.name ?? user.email ?? "Unknown user",
+      occurredAt: new Date().toISOString(),
+    });
+    return { stockAfter };
+  },
+});
+
+// Newest first
+export const listMovements = query({
+  args: { kind: movementKind, paginationOpts: paginationOptsValidator },
+  handler: async (ctx, args) => {
+    await requireActiveUser(ctx);
+    return await ctx.db
+      .query("stockMovements")
+      .withIndex("by_kind_and_occurredAt", (q) => q.eq("kind", args.kind))
+      .order("desc")
+      .paginate(args.paginationOpts);
+  },
+});
