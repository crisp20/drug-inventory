+import { usePaginatedQuery } from "convex/react";
+import { format } from "date-fns";
+import { History } from "lucide-react";
+import { api } from "@/convex/_generated/api.js";
+import { formatPackageForm } from "@/convex/lib/barcode.ts";
+import type { MovementKind } from "@/convex/lib/stock.ts";
+import { Badge } from "@/components/ui/badge.tsx";
+import { Button } from "@/components/ui/button.tsx";
+import {
+  Empty,
+  EmptyDescription,
+  EmptyHeader,
+  EmptyMedia,
+  EmptyTitle,
+} from "@/components/ui/empty.tsx";
+import { Skeleton } from "@/components/ui/skeleton.tsx";
+
+const PAGE_SIZE = 25;
+
+// Who recorded what, and when. Newest first.
+export default function MovementLog({ kind }: { kind: MovementKind }) {
+  const { results, status, loadMore } = usePaginatedQuery(api.stock.listMovements, { kind }, { initialNumItems: PAGE_SIZE });
+  const sign = kind === "in" ? "+" : "−";
+
+  if (status === "LoadingFirstPage") {
+    return (
+      <div className="space-y-2">
+        {Array.from({ length: 4 }).map((_, i) => (
+          <Skeleton key={i} className="h-16 w-full rounded-xl" />
+        ))}
+      </div>
+    );
+  }
+  if (status === "Exhausted" && results.length === 0) {
+    return (
+      <Empty className="border">
+        <EmptyHeader>
+          <EmptyMedia variant="icon">
+            <History />
+          </EmptyMedia>
+          <EmptyTitle>Nothing recorded yet</EmptyTitle>
+          <EmptyDescription>Each {kind === "in" ? "Stock In" : "Stock Out"} will appear here with who recorded it.</EmptyDescription>
+        </EmptyHeader>
+      </Empty>
+    );
+  }
+
+  return (
+    <div className="space-y-3">
+      <ul className="divide-y rounded-xl border bg-card">
+        {results.map((m) => (
+          <li key={m._id} className="flex gap-3 p-3">
+            <div className="w-14 shrink-0 pt-0.5 text-center text-lg font-extrabold text-primary">
+              {sign}
+              {m.quantity}
+            </div>
+            <div className="min-w-0 flex-1 space-y-0.5">
+              <div className="flex flex-wrap items-center gap-x-2 gap-y-1">
+                <span className="truncate font-semibold">{m.drugName}</span>
+                <span className="text-sm text-muted-foreground">{formatPackageForm(m)}</span>
+                {m.formChanged && (
+                  <Badge variant="secondary" className="text-[10px]">
+                    Form edited
+                  </Badge>
+                )}
+                {m.reason && <Badge variant="secondary">{m.reason}</Badge>}
+              </div>
+              <div className="truncate text-xs text-muted-foreground">
+                {m.barcode ? <span className="font-mono">{m.barcode}</span> : "No barcode"} · Stock {m.stockBefore} → {m.stockAfter}
+              </div>
+              {m.notes && <p className="whitespace-pre-line text-sm">{m.notes}</p>}
+            </div>
+            <div className="shrink-0 text-right text-xs text-muted-foreground">
+              <div className="font-medium text-foreground">{m.userName}</div>
+              <div>{format(new Date(m.occurredAt), "d MMM yyyy")}</div>
+              <div>{format(new Date(m.occurredAt), "h:mm a")}</div>
+            </div>
+          </li>
+        ))}
+      </ul>
+      {status === "CanLoadMore" && (
+        <Button variant="secondary" className="w-full" onClick={() => loadMore(PAGE_SIZE)}>
+          Load more
+        </Button>
+      )}
+    </div>
+  );
+}
