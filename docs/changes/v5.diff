+import { describe, expect, it } from "vitest";
+import { cleanMovementInput, formDiffers, nextStock } from "./stock";
+
+const form = { qtyPerUnit: 10, baseUnit: "Strip" as const, unitCount: 10 };
+
+describe("nextStock", () => {
+  it("adds on Stock In", () => {
+    expect(nextStock(3, "in", 5)).toBe(8);
+  });
+  it("subtracts on Stock Out and allows reaching zero", () => {
+    expect(nextStock(5, "out", 5)).toBe(0);
+  });
+  it("refuses to go below zero", () => {
+    expect(() => nextStock(2, "out", 3)).toThrow(/only 2 on hand/);
+  });
+});
+
+describe("cleanMovementInput", () => {
+  it("trims notes", () => {
+    expect(cleanMovementInput({ ...form, quantity: 2, notes: "  inv 12 " }).notes).toBe("inv 12");
+  });
+  it.each([0, -1, 1.5, 100_001])("rejects quantity %s", (quantity) => {
+    expect(() => cleanMovementInput({ ...form, quantity, notes: "" })).toThrow(/Quantity/);
+  });
+  it("rejects a bad package form", () => {
+    expect(() => cleanMovementInput({ ...form, qtyPerUnit: 0, quantity: 1, notes: "" })).toThrow(/per base unit/);
+    expect(() => cleanMovementInput({ ...form, unitCount: 2.5, quantity: 1, notes: "" })).toThrow(/base units/);
+  });
+  it("rejects very long notes", () => {
+    expect(() => cleanMovementInput({ ...form, quantity: 1, notes: "x".repeat(501) })).toThrow(/Notes/);
+  });
+});
+
+describe("formDiffers", () => {
+  it("detects edits to any part of the form", () => {
+    expect(formDiffers(form, form)).toBe(false);
+    expect(formDiffers(form, { ...form, unitCount: 5 })).toBe(true);
+    expect(formDiffers(form, { ...form, baseUnit: "Box" })).toBe(true);
+  });
+});
