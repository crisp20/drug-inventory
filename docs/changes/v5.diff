+import { convexTest } from "convex-test";
+import { describe, expect, it } from "vitest";
+import { api } from "./_generated/api";
+import schema from "./schema";
+import { modules } from "./test.setup";
+
+const OWNER = { tokenIdentifier: "iss|owner", email: "hubert@activecaregroup.com", name: "Hubert" };
+const STAFF = { tokenIdentifier: "iss|staff", email: "staff@example.com", name: "Sam" };
+
+const drug = {
+  drugId: "PCM500",
+  name: "Paracetamol 500mg",
+  brandName: "Panadol",
+  manufacturer: "GSK",
+  pieceName: "tablets",
+  packages: [
+    { barcode: "9312345678907", qtyPerUnit: 10, baseUnit: "Strip" as const, unitCount: 10, stock: 3, imageIds: [] },
+  ],
+};
+
+async function setup({ approveStaff = true } = {}) {
+  const t = convexTest(schema, modules);
+  const owner = t.withIdentity(OWNER);
+  const staff = t.withIdentity(STAFF);
+  await owner.mutation(api.users.updateCurrentUser, {});
+  await staff.mutation(api.users.updateCurrentUser, {});
+  if (approveStaff) {
+    const [pending] = await owner.query(api.users.listByStatus, { status: "pending" });
+    await owner.mutation(api.users.updateAccess, { userId: pending._id, role: "staff", status: "active" });
+  }
+  const drugRef = await owner.mutation(api.drugs.create, drug);
+  const created = await owner.query(api.drugs.get, { id: drugRef });
+  return { owner, staff, packageId: created!.packages[0]._id, drugRef };
+}
+
+const entry = { quantity: 4, qtyPerUnit: 10, baseUnit: "Strip" as const, unitCount: 10, notes: " Invoice 88 " };
+
+describe("Stock In", () => {
+  it("lets staff add stock and logs who did it", async () => {
+    const { owner, staff, packageId, drugRef } = await setup();
+    const result = await staff.mutation(api.stock.recordIn, { packageId, ...entry });
+    expect(result.stockAfter).toBe(7);
+
+    const updated = await owner.query(api.drugs.get, { id: drugRef });
+    expect(updated!.packages[0].stock).toBe(7);
+
+    const log = await owner.query(api.stock.listMovements, { kind: "in", paginationOpts: { numItems: 10, cursor: null } });
+    expect(log.page).toHaveLength(1);
+    expect(log.page[0]).toMatchObject({
+      quantity: 4,
+      stockBefore: 3,
+      stockAfter: 7,
+      userName: "Sam",
+      notes: "Invoice 88",
+      drugName: "Paracetamol 500mg",
+      formChanged: false,
+    });
+  });
+
+  it("records an edited package form without changing the saved one", async () => {
+    const { owner, packageId, drugRef } = await setup();
+    await owner.mutation(api.stock.recordIn, { packageId, ...entry, unitCount: 5 });
+    const log = await owner.query(api.stock.listMovements, { kind: "in", paginationOpts: { numItems: 10, cursor: null } });
+    expect(log.page[0]).toMatchObject({ unitCount: 5, formChanged: true });
+    const updated = await owner.query(api.drugs.get, { id: drugRef });
+    expect(updated!.packages[0].unitCount).toBe(10);
+  });
+
+  it("blocks users who are not approved", async () => {
+    const { staff, packageId } = await setup({ approveStaff: false });
+    await expect(staff.mutation(api.stock.recordIn, { packageId, ...entry })).rejects.toThrow(/approval/);
+  });
+
+  it("rejects invalid quantities and leaves stock unchanged", async () => {
+    const { owner, packageId, drugRef } = await setup();
+    await expect(owner.mutation(api.stock.recordIn, { packageId, ...entry, quantity: 0 })).rejects.toThrow(/Quantity/);
+    const updated = await owner.query(api.drugs.get, { id: drugRef });
+    expect(updated!.packages[0].stock).toBe(3);
+  });
+});
