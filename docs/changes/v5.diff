index 0000000..599d12f
--- /dev/null
+++ b/convex/lib/stock.ts
@@ -0,0 +1,49 @@
+import { ConvexError } from "convex/values";
+import type { BaseUnit } from "./barcode";
+
+export const MAX_MOVEMENT_QUANTITY = 100_000;
+export const MAX_NOTES_LENGTH = 500;
+
+export type MovementKind = "in" | "out";
+
+export type PackageForm = { qtyPerUnit: number; baseUnit: BaseUnit; unitCount: number };
+
+export type MovementInput = PackageForm & { quantity: number; notes: string };
+
+function bad(message: string): never {
+  throw new ConvexError({ code: "BAD_REQUEST", message });
+}
+
+function isPositiveInt(n: number) {
+  return Number.isInteger(n) && n > 0;
+}
+
+// Validates a stock movement entered by a user. Returns trimmed values.
+export function cleanMovementInput(input: MovementInput): MovementInput {
+  if (!isPositiveInt(input.quantity)) bad("Quantity must be a whole number above 0");
+  if (input.quantity > MAX_MOVEMENT_QUANTITY) {
+    bad(`Quantity can be at most ${MAX_MOVEMENT_QUANTITY.toLocaleString()}`);
+  }
+  if (!isPositiveInt(input.qtyPerUnit)) bad("Quantity per base unit must be a whole number above 0");
+  if (!isPositiveInt(input.unitCount)) bad("Number of base units must be a whole number above 0");
+  const notes = input.notes.trim();
+  if (notes.length > MAX_NOTES_LENGTH) bad(`Notes can be at most ${MAX_NOTES_LENGTH} characters`);
+  return { ...input, notes };
+}
+
+// New stock amount (in package forms) after a movement. Stock can never go below 0.
+export function nextStock(current: number, kind: MovementKind, quantity: number): number {
+  if (kind === "in") return current + quantity;
+  if (quantity > current) {
+    bad(`Not enough stock: only ${current} on hand`);
+  }
+  return current - quantity;
+}
+
+export function formDiffers(saved: PackageForm, recorded: PackageForm): boolean {
+  return (
+    saved.qtyPerUnit !== recorded.qtyPerUnit ||
+    saved.baseUnit !== recorded.baseUnit ||
+    saved.unitCount !== recorded.unitCount
+  );
+}
