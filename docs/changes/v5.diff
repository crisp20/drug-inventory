@@ -0,0 +1,122 @@
+import { useForm, useWatch } from "react-hook-form";
+import { zodResolver } from "@hookform/resolvers/zod";
+import { useMutation } from "convex/react";
+import { ArrowDownToLine } from "lucide-react";
+import { toast } from "sonner";
+import { api } from "@/convex/_generated/api.js";
+import { formatPackageForm } from "@/convex/lib/barcode.ts";
+import { formDiffers } from "@/convex/lib/stock.ts";
+import { Button } from "@/components/ui/button.tsx";
+import { Form, FormControl, FormField, FormItem, FormLabel, FormMessage } from "@/components/ui/form.tsx";
+import { Input } from "@/components/ui/input.tsx";
+import { Spinner } from "@/components/ui/spinner.tsx";
+import { Textarea } from "@/components/ui/textarea.tsx";
+import PackageFormFields from "@/components/stock/package-form-fields.tsx";
+import {
+  movementFormSchema,
+  type MovementFormInput,
+  type MovementFormValues,
+} from "@/components/stock/movement-form-schema.ts";
+import type { StockSelection } from "@/components/stock/stock-drug-finder.tsx";
+import { errorMessage } from "@/lib/errors.ts";
+
+type Props = { selection: StockSelection; onDone: () => void };
+
+function toNumber(value: string | number | undefined): number {
+  const n = Number(value);
+  return Number.isFinite(n) ? n : 0;
+}
+
+export default function StockInForm({ selection, onDone }: Props) {
+  const { drug, pkg } = selection;
+  const recordIn = useMutation(api.stock.recordIn);
+  const form = useForm<MovementFormInput, unknown, MovementFormValues>({
+    resolver: zodResolver(movementFormSchema),
+    defaultValues: { quantity: 1, qtyPerUnit: pkg.qtyPerUnit, baseUnit: pkg.baseUnit, unitCount: pkg.unitCount, notes: "" },
+  });
+  const watched = useWatch({ control: form.control });
+  const quantity = toNumber(watched.quantity);
+  const recordedForm = {
+    qtyPerUnit: toNumber(watched.qtyPerUnit),
+    baseUnit: watched.baseUnit ?? pkg.baseUnit,
+    unitCount: toNumber(watched.unitCount),
+  };
+  const changed = formDiffers(pkg, recordedForm);
+
+  const onSubmit = async (values: MovementFormValues) => {
+    try {
+      const { stockAfter } = await recordIn({ packageId: pkg._id, ...values });
+      toast.success(`Added ${values.quantity} × ${formatPackageForm(values)} of ${drug.name}`, {
+        description: `Stock is now ${stockAfter}`,
+      });
+      onDone();
+    } catch (e) {
+      toast.error(errorMessage(e, "Could not record Stock In"));
+    }
+  };
+
+  return (
+    <Form {...form}>
+      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-5 rounded-xl border-2 border-primary/30 bg-card p-4">
+        <div className="flex items-baseline justify-between gap-3">
+          <h2 className="text-lg font-bold">Stock In</h2>
+          <span className="truncate text-sm text-muted-foreground">{drug.name}</span>
+        </div>
+
+        <FormField
+          control={form.control}
+          name="quantity"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel>Quantity received</FormLabel>
+              <FormControl>
+                <Input
+                  {...field}
+                  value={String(field.value)}
+                  inputMode="numeric"
+                  autoFocus
+                  onFocus={(e) => e.target.select()}
+                  className="h-14 bg-background text-center text-2xl font-extrabold"
+                />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+
+        <PackageFormFields control={form.control} changed={changed} />
+
+        <FormField
+          control={form.control}
+          name="notes"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel>Notes</FormLabel>
+              <FormControl>
+                <Textarea {...field} rows={2} placeholder="e.g. Invoice #4521 from supplier" className="bg-background" />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+
+        <div className="flex items-center justify-between gap-3 rounded-lg bg-muted px-3 py-2 text-sm">
+          <span className="text-muted-foreground">Stock after</span>
+          <span className="font-semibold">
+            {pkg.stock} → <span className="text-lg font-extrabold">{pkg.stock + (quantity > 0 ? quantity : 0)}</span>
+          </span>
+        </div>
+
+        <div className="flex gap-2">
+          <Button type="button" variant="ghost" onClick={onDone}>
+            Cancel
+          </Button>
+          <Button type="submit" size="lg" className="flex-1" disabled={form.formState.isSubmitting}>
+            {form.formState.isSubmitting ? <Spinner /> : <ArrowDownToLine />}
+            Record Stock In
+          </Button>
+        </div>
+      </form>
+    </Form>
+  );
+}
