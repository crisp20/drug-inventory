+import type { MovementFormInput, MovementFormValues } from "./movement-form-schema.ts";
+
+type Props = {
+  control: Control<MovementFormInput, unknown, MovementFormValues>;
+  changed: boolean;
+};
+
+// Editable "Qty / Base unit x No." fields, prefilled from the barcode's saved form
+export default function PackageFormFields({ control, changed }: Props) {
