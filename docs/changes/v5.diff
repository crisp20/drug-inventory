+import { Barcode, Check } from "lucide-react";
+import { formatPackageForm } from "@/convex/lib/barcode.ts";
+import DrugImage from "@/components/drug-image.tsx";
+import type { DrugPackage, DrugWithDetails } from "@/lib/drug-types.ts";
+import { cn } from "@/lib/utils.ts";
+
+type Props = {
+  drug: DrugWithDetails;
+  selectedPackageId?: string;
+  matchedPackageId?: string;
+  onPick: (pkg: DrugPackage) => void;
+};
+
+// A drug with one tappable button per package form (barcode)
+export default function DrugPackagePicker({ drug, selectedPackageId, matchedPackageId, onPick }: Props) {
+  return (
+    <div className="rounded-xl border bg-card p-3">
+      <div className="flex items-center gap-3 pb-3">
+        <DrugImage url={drug.imageUrl} alt={drug.name} className="size-12 shrink-0" />
+        <div className="min-w-0">
+          <div className="truncate font-semibold">{drug.name}</div>
+          <div className="truncate text-sm text-muted-foreground">
+            {drug.brandName || "No brand"} · <span className="font-mono">{drug.drugId}</span>
+          </div>
+        </div>
+      </div>
+      <div className="grid gap-2 sm:grid-cols-2">
+        {drug.packages.map((p) => {
+          const selected = p._id === selectedPackageId;
+          return (
+            <button
+              key={p._id}
+              type="button"
+              onClick={() => onPick(p)}
+              className={cn(
+                "flex cursor-pointer items-center justify-between gap-3 rounded-lg border px-3 py-2 text-left transition-colors",
+                selected ? "border-primary bg-secondary" : "hover:bg-muted",
+                p._id === matchedPackageId && !selected && "border-accent-foreground/40 bg-accent/40",
+              )}
+            >
+              <div className="min-w-0">
+                <div className="font-semibold">{formatPackageForm(p)}</div>
+                <div className="flex items-center gap-1 truncate text-xs text-muted-foreground">
+                  <Barcode className="size-3 shrink-0" />
+                  {p.barcode ? <span className="truncate font-mono">{p.barcode}</span> : <span className="italic">No barcode</span>}
+                </div>
+              </div>
+              <div className="flex shrink-0 items-center gap-2">
+                <div className="text-right">
+                  <div className="text-lg font-extrabold leading-none">{p.stock}</div>
+                  <div className="text-[10px] uppercase tracking-wide text-muted-foreground">in stock</div>
+                </div>
+                {selected && <Check className="size-4 text-primary" />}
+              </div>
+            </button>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
