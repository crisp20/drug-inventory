+            <FormItem>
+              <FormLabel className="text-xs">Qty per unit</FormLabel>
+              <FormControl>
+                <Input {...field} value={String(field.value)} inputMode="numeric" className="h-11 bg-card text-center" />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+        <FormField
+          control={control}
+          name="baseUnit"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel className="text-xs">Base unit</FormLabel>
+              <Select value={field.value} onValueChange={field.onChange}>
+                <FormControl>
+                  <SelectTrigger className="h-11 w-full bg-card data-[size=default]:h-11">
+                    <SelectValue />
+                  </SelectTrigger>
+                </FormControl>
+                <SelectContent>
+                  {BASE_UNITS.map((u) => (
+                    <SelectItem key={u} value={u}>
+                      {u}
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+            </FormItem>
+          )}
+        />
+        <FormField
+          control={control}
+          name="unitCount"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel className="text-xs">No. of units</FormLabel>
+              <FormControl>
+                <Input {...field} value={String(field.value)} inputMode="numeric" className="h-11 bg-card text-center" />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+      </div>
+      {changed && (
+        <p className="rounded-lg bg-accent px-3 py-2 text-xs text-accent-foreground">
+          This differs from the saved package form. It will be noted in the log; stock is still added to this barcode.
+        </p>
+      )}
+    </div>
+  );
+}
