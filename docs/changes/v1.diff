+import { describe, expect, it } from "vitest";
+import { extractGtin, formatPackageForm, normalizeBarcode } from "./barcode";
+
+describe("normalizeBarcode", () => {
+  it("pads EAN-13 to GTIN-14 so it matches the GS1 form", () => {
+    expect(normalizeBarcode("9312345678907")).toBe("09312345678907");
+  });
+
+  it("extracts GTIN from bracketed GS1 strings", () => {
+    expect(normalizeBarcode("(01)09312345678907(17)261231(10)AB12")).toBe("09312345678907");
+  });
+
+  it("extracts GTIN from raw GS1 DataMatrix with symbology prefix and separators", () => {
+    expect(extractGtin("]d201093123456789071726123110AB12\u001d21XYZ")).toBe("09312345678907");
+  });
+
+  it("keeps non-numeric codes, uppercased and trimmed", () => {
+    expect(normalizeBarcode("  abc-123 ")).toBe("ABC-123");
+  });
+});
+
+describe("formatPackageForm", () => {
+  it("formats qty/unit x count", () => {
+    expect(formatPackageForm({ qtyPerUnit: 10, baseUnit: "Strip", unitCount: 10 })).toBe("10/Strip x10");
+  });
+});
diff --git a/convex/lib/barcode.ts b/convex/lib/barcode.ts
new file mode 100644
index 0000000..2bc7b8d
--- /dev/null
+++ b/convex/lib/barcode.ts
@@ -0,0 +1,32 @@
+// Shared by backend and frontend: turns any scanned/typed code into a lookup key.
+// GS1 strings (e.g. "(01)09312345678907(17)261231" or "0109312345678907...")
+// are reduced to their GTIN; numeric GTIN-8/12/13/14 are padded to 14 digits
+// so the same product matches regardless of which format was scanned.
+
+const SYMBOLOGY_PREFIX = /^\][A-Za-z]\d/;
+// GS1 group separator (ASCII 29) inserted between variable-length fields
+const GS1_SEPARATOR = new RegExp(String.fromCharCode(29), "g");
+
+export function extractGtin(raw: string): string | null {
+  const code = raw.trim().replace(SYMBOLOGY_PREFIX, "").replace(GS1_SEPARATOR, "");
+  const bracketed = code.match(/\(01\)\s*(\d{14})/);
+  if (bracketed) return bracketed[1];
+  if (/^01\d{14}/.test(code) && code.length > 14) return code.slice(2, 16);
+  if (/^(\d{8}|\d{12}|\d{13}|\d{14})$/.test(code)) return code.padStart(14, "0");
+  return null;
+}
+
+export function normalizeBarcode(raw: string): string {
+  return extractGtin(raw) ?? raw.trim().toUpperCase();
+}
+
+export const BASE_UNITS = ["Strip", "Box", "Bottle", "Bag"] as const;
+export type BaseUnit = (typeof BASE_UNITS)[number];
+
+export function formatPackageForm(p: {
+  qtyPerUnit: number;
+  baseUnit: BaseUnit;
+  unitCount: number;
+}): string {
+  return `${p.qtyPerUnit}/${p.baseUnit} x${p.unitCount}`;
+}
diff --git a/convex/lib/drugs.ts b/convex/lib/drugs.ts
new file mode 100644
index 0000000..20ad236
--- /dev/null
+++ b/convex/lib/drugs.ts
@@ -0,0 +1,133 @@
+import { ConvexError } from "convex/values";
+import type { MutationCtx, QueryCtx } from "../_generated/server";
+import type { Doc, Id } from "../_generated/dataModel";
+import { normalizeBarcode, type BaseUnit } from "./barcode";
+
+export const MAX_PACKAGING_IMAGES = 10;
+export const MAX_PACKAGES_PER_DRUG = 20;
+
+export type PackageInput = {
+  packageId?: Id<"drugPackages">;
+  barcode: string;
+  qtyPerUnit: number;
+  baseUnit: BaseUnit;
+  unitCount: number;
+  stock: number;
+};
+
+export type DrugInput = {
+  drugId: string;
+  name: string;
+  brandName: string;
+  manufacturer: string;
+  pieceName: string;
+  imageId?: Id<"_storage">;
+  packagingImageIds: Id<"_storage">[];
+  packages: PackageInput[];
+};
+
+function bad(message: string): never {
+  throw new ConvexError({ code: "BAD_REQUEST", message });
+}
+
+function isPositiveInt(n: number) {
+  return Number.isInteger(n) && n > 0;
+}
+
+// Validates and trims user input. Returns cleaned values.
+export function cleanDrugInput(input: DrugInput): DrugInput {
+  const drugId = input.drugId.trim();
+  const name = input.name.trim();
+  if (!drugId) bad("Drug ID is required");
+  if (drugId.length > 64) bad("Drug ID must be 64 characters or fewer");
+  if (!name) bad("Drug name is required");
+  if (input.packagingImageIds.length > MAX_PACKAGING_IMAGES) {
+    bad(`You can add up to ${MAX_PACKAGING_IMAGES} packaging pictures`);
+  }
+  if (input.packages.length === 0) bad("Add at least one barcode and package form");
+  if (input.packages.length > MAX_PACKAGES_PER_DRUG) {
+    bad(`A drug can have up to ${MAX_PACKAGES_PER_DRUG} barcodes`);
+  }
+
+  const seen = new Set<string>();
+  const packages = input.packages.map((p) => {
+    const barcode = p.barcode.trim();
+    if (!barcode) bad("Every package form needs a barcode");
+    const key = normalizeBarcode(barcode);
+    if (seen.has(key)) bad(`Barcode ${barcode} is listed twice`);
+    seen.add(key);
+    if (!isPositiveInt(p.qtyPerUnit)) bad("Quantity per base unit must be a whole number above 0");
+    if (!isPositiveInt(p.unitCount)) bad("Number of base units must be a whole number above 0");
+    if (!Number.isInteger(p.stock) || p.stock < 0) bad("Stock amount must be a whole number, 0 or more");
+    return { ...p, barcode };
+  });
+
+  return {
+    ...input,
+    drugId,
+    name,
+    brandName: input.brandName.trim(),
+    manufacturer: input.manufacturer.trim(),
+    pieceName: input.pieceName.trim() || "units",
+    packages,
+  };
+}
+
+export function buildSearchText(d: Pick<DrugInput, "drugId" | "name" | "brandName">) {
+  return [d.drugId, d.name, d.brandName].join(" ");
+}
+
+export async function assertDrugIdFree(ctx: QueryCtx, drugId: string, exceptId?: Id<"drugs">) {
+  const existing = await ctx.db
+    .query("drugs")
+    .withIndex("by_drugId", (q) => q.eq("drugId", drugId))
+    .first();
+  if (existing && existing._id !== exceptId) {
+    throw new ConvexError({ code: "CONFLICT", message: `Drug ID ${drugId} already exists` });
+  }
+}
+
+export async function assertBarcodesFree(
+  ctx: QueryCtx,
+  packages: PackageInput[],
+  drugRef?: Id<"drugs">,
+) {
+  for (const p of packages) {
+    const existing = await ctx.db
+      .query("drugPackages")
+      .withIndex("by_barcodeKey", (q) => q.eq("barcodeKey", normalizeBarcode(p.barcode)))
+      .first();
+    if (existing && existing.drugRef !== drugRef) {
+      throw new ConvexError({
+        code: "CONFLICT",
+        message: `Barcode ${p.barcode} already belongs to another drug`,
+      });
+    }
+  }
+}
+
+export async function getPackages(ctx: QueryCtx, drugRef: Id<"drugs">) {
+  return await ctx.db
+    .query("drugPackages")
+    .withIndex("by_drug", (q) => q.eq("drugRef", drugRef))
+    .take(MAX_PACKAGES_PER_DRUG);
+}
+
+// Adds image URLs and package forms for display
+export async function withDetails(ctx: QueryCtx, drug: Doc<"drugs">) {
+  const [imageUrl, packagingImages, packages] = await Promise.all([
+    drug.imageId ? ctx.storage.getUrl(drug.imageId) : Promise.resolve(null),
+    Promise.all(
+      drug.packagingImageIds.map(async (id) => ({ id, url: await ctx.storage.getUrl(id) })),
+    ),
+    getPackages(ctx, drug._id),
+  ]);
+  return { ...drug, imageUrl, packagingImages, packages };
+}
+
+export async function deleteFiles(ctx: MutationCtx, ids: Id<"_storage">[]) {
+  for (const id of ids) {
+    const meta = await ctx.db.system.get("_storage", id);
+    if (meta) await ctx.storage.delete(id);
+  }
+}
