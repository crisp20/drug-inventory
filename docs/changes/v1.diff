+                    </SelectContent>
+                  </Select>
+                </FormItem>
+              )}
+            />
+            <span className="pt-2">x</span>
+            <FormField
+              control={control}
+              name={`packages.${index}.unitCount`}
+              render={({ field: f }) => (
