@@ -0,0 +1,134 @@
+import { NavLink, Outlet } from "react-router-dom";
+import { AuthLoading, Authenticated, Unauthenticated } from "convex/react";
+import { ArrowDownToLine, ArrowUpFromLine, Boxes, Users, type LucideIcon } from "lucide-react";
+import { toast } from "sonner";
+import { SignInButton } from "@/components/ui/signin.tsx";
+import { Skeleton } from "@/components/ui/skeleton.tsx";
+import { useCurrentUser } from "@/hooks/use-current-user.ts";
+import { cn } from "@/lib/utils.ts";
+import { AwaitingApprovalScreen, SignedOutScreen } from "./access-screens.tsx";
+import BrandLogo from "./brand-logo.tsx";
+import { RootErrorBoundary } from "./root-error-boundary.tsx";
+
+type NavItem = { label: string; icon: LucideIcon; to?: string; adminOnly?: boolean };
+
+const NAV: NavItem[] = [
+  { label: "Inventory", icon: Boxes, to: "/" },
+  { label: "Stock In", icon: ArrowDownToLine },
+  { label: "Stock Out", icon: ArrowUpFromLine },
+  { label: "Users", icon: Users, to: "/users", adminOnly: true },
+];
+
+function NavEntry({ item, compact }: { item: NavItem; compact?: boolean }) {
+  const base = compact
+    ? "flex flex-1 flex-col items-center gap-1 py-2 text-[11px] font-medium"
+    : "flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors";
+  if (!item.to) {
+    return (
+      <button
+        type="button"
+        onClick={() => toast("Coming soon in a future milestone!")}
+        className={cn(base, "cursor-pointer opacity-70 hover:opacity-100", !compact && "hover:bg-sidebar-accent")}
+      >
+        <item.icon className="size-5" />
+        {item.label}
+      </button>
+    );
+  }
+  return (
+    <NavLink
+      to={item.to}
+      end
+      className={({ isActive }) =>
+        cn(
+          base,
+          "cursor-pointer",
+          compact
+            ? isActive
+              ? "text-primary"
+              : "text-muted-foreground"
+            : isActive
+              ? "bg-sidebar-primary text-sidebar-primary-foreground"
+              : "hover:bg-sidebar-accent",
+        )
+      }
+    >
+      <item.icon className="size-5" />
+      {item.label}
+    </NavLink>
+  );
+}
+
+function Shell() {
+  const user = useCurrentUser();
+  if (user === undefined) return <FullPageSkeleton />;
+  if (!user || user.status !== "active") {
+    return <AwaitingApprovalScreen disabled={user?.status === "disabled"} />;
+  }
+  const items = NAV.filter((n) => !n.adminOnly || user.role === "admin");
+
+  return (
+    <div className="flex h-screen bg-background">
+      <aside className="hidden w-64 shrink-0 flex-col bg-sidebar p-4 text-sidebar-foreground md:flex">
+        <BrandLogo className="px-2 pb-8 pt-2" />
+        <nav className="flex flex-1 flex-col gap-1">
+          {items.map((item) => (
+            <NavEntry key={item.label} item={item} />
+          ))}
+        </nav>
+        <div className="space-y-3 border-t border-sidebar-border pt-4">
+          <div className="px-2">
+            <div className="truncate text-sm font-semibold">{user.name ?? user.email}</div>
+            <div className="text-xs capitalize opacity-70">{user.role}</div>
+          </div>
+          <SignInButton variant="ghost" size="sm" className="w-full justify-start hover:bg-sidebar-accent hover:text-sidebar-foreground" />
+        </div>
+      </aside>
+      <div className="flex min-w-0 flex-1 flex-col">
+        <header className="flex items-center justify-between border-b bg-sidebar px-4 py-3 text-sidebar-foreground md:hidden">
+          <BrandLogo />
+          <SignInButton variant="ghost" size="sm" showIcon={false} className="hover:bg-sidebar-accent hover:text-sidebar-foreground" />
+        </header>
+        <main className="flex-1 overflow-auto pb-20 md:pb-0">
+          <RootErrorBoundary>
+            <Outlet />
+          </RootErrorBoundary>
+        </main>
+      </div>
+      <nav className="fixed inset-x-0 bottom-0 flex border-t bg-background md:hidden">
+        {items.map((item) => (
+          <NavEntry key={item.label} item={item} compact />
+        ))}
+      </nav>
+    </div>
+  );
+}
+
+function FullPageSkeleton() {
+  return (
+    <div className="flex h-screen">
+      <Skeleton className="hidden h-full w-64 rounded-none md:block" />
+      <div className="flex-1 space-y-4 p-8">
+        <Skeleton className="h-10 w-64" />
+        <Skeleton className="h-12 w-full" />
+        <Skeleton className="h-40 w-full" />
+      </div>
+    </div>
+  );
+}
+
+export default function AppLayout() {
+  return (
+    <>
+      <AuthLoading>
+        <FullPageSkeleton />
+      </AuthLoading>
+      <Unauthenticated>
+        <SignedOutScreen />
+      </Unauthenticated>
+      <Authenticated>
+        <Shell />
+      </Authenticated>
+    </>
+  );
+}
