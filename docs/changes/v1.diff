@@ -0,0 +1,75 @@
+import { convexTest } from "convex-test";
+import { describe, expect, it } from "vitest";
+import { api } from "./_generated/api";
+import schema from "./schema";
+import { modules } from "./test.setup";
+
+const OWNER = { tokenIdentifier: "iss|owner", email: "Hubert@ActiveCareGroup.com", name: "Hubert" };
+const STAFF = { tokenIdentifier: "iss|staff", email: "staff@example.com", name: "Sam" };
+
+const drug = {
+  drugId: "PCM500",
+  name: "Paracetamol 500mg",
+  brandName: "Panadol",
+  manufacturer: "GSK",
+  pieceName: "tablets",
+  packagingImageIds: [],
+  packages: [
+    { barcode: "9312345678907", qtyPerUnit: 10, baseUnit: "Strip" as const, unitCount: 10, stock: 3 },
+  ],
+};
+
+async function setup() {
+  const t = convexTest(schema, modules);
+  const owner = t.withIdentity(OWNER);
+  const staff = t.withIdentity(STAFF);
+  await owner.mutation(api.users.updateCurrentUser, {});
+  await staff.mutation(api.users.updateCurrentUser, {});
+  return { t, owner, staff };
+}
+
+describe("access", () => {
+  it("makes the owner an active admin and new users pending", async () => {
+    const { owner, staff } = await setup();
+    expect(await owner.query(api.users.getCurrentUser, {})).toMatchObject({ role: "admin", status: "active" });
+    expect(await staff.query(api.users.getCurrentUser, {})).toMatchObject({ role: "staff", status: "pending" });
+  });
+
+  it("blocks pending users from reading inventory", async () => {
+    const { staff } = await setup();
+    await expect(staff.query(api.drugs.search, { term: "x" })).rejects.toThrow(/approval/);
+  });
+
+  it("lets approved staff read but not edit", async () => {
+    const { owner, staff } = await setup();
+    await owner.mutation(api.drugs.create, drug);
+    const [pending] = await owner.query(api.users.listByStatus, { status: "pending" });
+    await owner.mutation(api.users.updateAccess, { userId: pending._id, role: "staff", status: "active" });
+
+    const found = await staff.query(api.drugs.search, { term: "(01)09312345678907" });
+    expect(found).toHaveLength(1);
+    await expect(staff.mutation(api.drugs.create, { ...drug, drugId: "X2" })).rejects.toThrow(/admins/);
+  });
+});
+
+describe("drugs", () => {
+  it("rejects duplicate Drug IDs and barcodes", async () => {
+    const { owner } = await setup();
+    await owner.mutation(api.drugs.create, drug);
+    await expect(owner.mutation(api.drugs.create, drug)).rejects.toThrow(/already exists/);
+    await expect(
+      owner.mutation(api.drugs.create, {
+        ...drug,
+        drugId: "OTHER",
+        packages: [{ ...drug.packages[0], barcode: "09312345678907" }],
+      }),
+    ).rejects.toThrow(/another drug/);
+  });
+
+  it("rejects negative stock", async () => {
+    const { owner } = await setup();
+    await expect(
+      owner.mutation(api.drugs.create, { ...drug, packages: [{ ...drug.packages[0], stock: -1 }] }),
+    ).rejects.toThrow(/Stock/);
+  });
+});
diff --git a/convex/drugs.ts b/convex/drugs.ts
new file mode 100644
index 0000000..9dfbc6c
--- /dev/null
+++ b/convex/drugs.ts
@@ -0,0 +1,202 @@
+import { paginationOptsValidator } from "convex/server";
+import { ConvexError, v } from "convex/values";
+import { mutation, query } from "./_generated/server";
+import type { Doc, Id } from "./_generated/dataModel";
+import { requireActiveUser, requireAdmin } from "./lib/access";
+import { normalizeBarcode } from "./lib/barcode";
+import {
+  assertBarcodesFree,
+  assertDrugIdFree,
+  buildSearchText,
+  cleanDrugInput,
+  deleteFiles,
+  getPackages,
+  withDetails,
+} from "./lib/drugs";
+import { baseUnit } from "./schema/drugs";
+
+const packageArg = v.object({
+  packageId: v.optional(v.id("drugPackages")),
+  barcode: v.string(),
+  qtyPerUnit: v.number(),
+  baseUnit: baseUnit,
+  unitCount: v.number(),
+  stock: v.number(),
+});
+
+const drugArgs = {
+  drugId: v.string(),
+  name: v.string(),
+  brandName: v.string(),
+  manufacturer: v.string(),
+  pieceName: v.string(),
+  imageId: v.optional(v.id("_storage")),
+  packagingImageIds: v.array(v.id("_storage")),
+  packages: v.array(packageArg),
+};
+
+export const generateUploadUrl = mutation({
+  args: {},
+  handler: async (ctx) => {
+    await requireAdmin(ctx);
+    return await ctx.storage.generateUploadUrl();
+  },
+});
+
+export const list = query({
+  args: { paginationOpts: paginationOptsValidator },
+  handler: async (ctx, args) => {
+    await requireActiveUser(ctx);
+    const result = await ctx.db
+      .query("drugs")
+      .withIndex("by_name")
+      .order("asc")
+      .paginate(args.paginationOpts);
+    return {
+      ...result,
+      page: await Promise.all(result.page.map((d) => withDetails(ctx, d))),
+    };
+  },
+});
+
+// Finds drugs by barcode/GS1 code (exact) or by Drug ID, name, or brand (text)
+export const search = query({
+  args: { term: v.string() },
+  handler: async (ctx, args) => {
+    await requireActiveUser(ctx);
+    const term = args.term.trim();
+    if (!term) return [];
+
+    const found = new Map<Id<"drugs">, Doc<"drugs">>();
+    const pkg = await ctx.db
+      .query("drugPackages")
+      .withIndex("by_barcodeKey", (q) => q.eq("barcodeKey", normalizeBarcode(term)))
+      .first();
+    if (pkg) {
+      const drug = await ctx.db.get("drugs", pkg.drugRef);
+      if (drug) found.set(drug._id, drug);
+    }
+    const byId = await ctx.db
+      .query("drugs")
+      .withIndex("by_drugId", (q) => q.eq("drugId", term))
+      .first();
+    if (byId) found.set(byId._id, byId);
+
+    const textMatches = await ctx.db
+      .query("drugs")
+      .withSearchIndex("search_text", (q) => q.search("searchText", term))
+      .take(30);
+    for (const d of textMatches) found.set(d._id, d);
+
+    return await Promise.all([...found.values()].map((d) => withDetails(ctx, d)));
+  },
+});
+
+export const get = query({
+  args: { id: v.string() },
+  handler: async (ctx, args) => {
+    await requireActiveUser(ctx);
+    const id = ctx.db.normalizeId("drugs", args.id);
+    if (!id) return null;
+    const drug = await ctx.db.get("drugs", id);
+    return drug ? await withDetails(ctx, drug) : null;
+  },
+});
+
+export const create = mutation({
+  args: drugArgs,
+  handler: async (ctx, args) => {
+    await requireAdmin(ctx);
+    const input = cleanDrugInput(args);
+    await assertDrugIdFree(ctx, input.drugId);
+    await assertBarcodesFree(ctx, input.packages);
+
+    const drugRef = await ctx.db.insert("drugs", {
+      drugId: input.drugId,
+      name: input.name,
+      brandName: input.brandName,
+      manufacturer: input.manufacturer,
+      pieceName: input.pieceName,
+      imageId: input.imageId,
+      packagingImageIds: input.packagingImageIds,
+      searchText: buildSearchText(input),
+      updatedAt: new Date().toISOString(),
+    });
+    for (const p of input.packages) {
+      await ctx.db.insert("drugPackages", {
+        drugRef,
+        barcode: p.barcode,
+        barcodeKey: normalizeBarcode(p.barcode),
+        qtyPerUnit: p.qtyPerUnit,
+        baseUnit: p.baseUnit,
+        unitCount: p.unitCount,
+        stock: p.stock,
+      });
+    }
+    return drugRef;
+  },
+});
+
+export const update = mutation({
+  args: { id: v.id("drugs"), ...drugArgs },
+  handler: async (ctx, { id, ...rest }) => {
+    await requireAdmin(ctx);
+    const drug = await ctx.db.get("drugs", id);
+    if (!drug) throw new ConvexError({ code: "NOT_FOUND", message: "Drug not found" });
+    const input = cleanDrugInput(rest);
+    await assertDrugIdFree(ctx, input.drugId, id);
+    await assertBarcodesFree(ctx, input.packages, id);
+
+    // Remove pictures that were replaced or taken out
+    const kept = new Set<Id<"_storage">>(input.packagingImageIds);
+    if (input.imageId) kept.add(input.imageId);
+    const oldFiles = [...drug.packagingImageIds, ...(drug.imageId ? [drug.imageId] : [])];
+    await deleteFiles(ctx, oldFiles.filter((f) => !kept.has(f)));
+
+    await ctx.db.patch("drugs", id, {
+      drugId: input.drugId,
+      name: input.name,
+      brandName: input.brandName,
+      manufacturer: input.manufacturer,
+      pieceName: input.pieceName,
+      imageId: input.imageId,
+      packagingImageIds: input.packagingImageIds,
+      searchText: buildSearchText(input),
+      updatedAt: new Date().toISOString(),
+    });
+
+    const existing = await getPackages(ctx, id);
+    const incomingIds = new Set(input.packages.map((p) => p.packageId).filter(Boolean));
+    for (const old of existing) {
+      if (!incomingIds.has(old._id)) await ctx.db.delete("drugPackages", old._id);
+    }
+    for (const p of input.packages) {
+      const fields = {
+        barcode: p.barcode,
+        barcodeKey: normalizeBarcode(p.barcode),
+        qtyPerUnit: p.qtyPerUnit,
+        baseUnit: p.baseUnit,
+        unitCount: p.unitCount,
+        stock: p.stock,
+      };
+      const match = existing.find((e) => e._id === p.packageId);
+      if (match) await ctx.db.patch("drugPackages", match._id, fields);
+      else await ctx.db.insert("drugPackages", { drugRef: id, ...fields });
+    }
+    return null;
+  },
+});
+
+export const remove = mutation({
+  args: { id: v.id("drugs") },
+  handler: async (ctx, args) => {
+    await requireAdmin(ctx);
+    const drug = await ctx.db.get("drugs", args.id);
+    if (!drug) throw new ConvexError({ code: "NOT_FOUND", message: "Drug not found" });
+    const packages = await getPackages(ctx, args.id);
+    for (const p of packages) await ctx.db.delete("drugPackages", p._id);
+    await deleteFiles(ctx, [...drug.packagingImageIds, ...(drug.imageId ? [drug.imageId] : [])]);
+    await ctx.db.delete("drugs", args.id);
+    return null;
+  },
+});
