+  type DrugFormValues,
+} from "../_lib/drug-form-schema.ts";
+import ImagePicker, { type PickedImage } from "./image-picker.tsx";
+import PackageRowsEditor from "./package-rows-editor.tsx";
+
+const MAX_PACKAGING_IMAGES = 10;
+
+type Props = {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  drug?: DrugWithDetails;
+};
+
+function defaultsFor(drug?: DrugWithDetails): DrugFormInput {
+  if (!drug) {
+    return { drugId: "", name: "", brandName: "", manufacturer: "", pieceName: "tablets", packages: [{ ...EMPTY_PACKAGE }] };
+  }
+  return {
+    drugId: drug.drugId,
+    name: drug.name,
+    brandName: drug.brandName,
+    manufacturer: drug.manufacturer,
+    pieceName: drug.pieceName,
+    packages: drug.packages.map((p) => ({
+      packageId: p._id,
+      barcode: p.barcode,
+      qtyPerUnit: p.qtyPerUnit,
+      baseUnit: p.baseUnit,
+      unitCount: p.unitCount,
+      stock: p.stock,
+    })),
+  };
+}
+
+function DrugForm({ drug, onDone }: { drug?: DrugWithDetails; onDone: () => void }) {
+  const create = useMutation(api.drugs.create);
+  const update = useMutation(api.drugs.update);
+  const form = useForm<DrugFormInput, unknown, DrugFormValues>({
+    resolver: zodResolver(drugFormSchema),
+    defaultValues: defaultsFor(drug),
+  });
+  const [mainImage, setMainImage] = useState<PickedImage[]>(
+    drug?.imageId ? [{ id: drug.imageId, url: drug.imageUrl }] : [],
+  );
+  const [packaging, setPackaging] = useState<PickedImage[]>(drug?.packagingImages ?? []);
+
+  const onSubmit = async (values: DrugFormValues) => {
+    const payload = {
+      ...values,
+      imageId: mainImage[0]?.id,
+      packagingImageIds: packaging.map((p) => p.id),
+    };
+    try {
+      if (drug) await update({ id: drug._id, ...payload });
+      else await create(payload);
+      toast.success(drug ? "Drug updated" : "Drug added");
+      onDone();
+    } catch (e) {
+      toast.error(errorMessage(e, "Could not save drug"));
+    }
+  };
+
+  const textField = (name: "drugId" | "name" | "brandName" | "pieceName", label: string, placeholder: string) => (
+    <FormField
+      control={form.control}
+      name={name}
+      render={({ field }) => (
+        <FormItem>
+          <FormLabel>{label}</FormLabel>
+          <FormControl>
+            <Input {...field} placeholder={placeholder} />
+          </FormControl>
+          <FormMessage />
+        </FormItem>
+      )}
+    />
+  );
+
+  return (
+    <Form {...form}>
+      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
+        <div className="grid gap-4 sm:grid-cols-2">
+          {textField("drugId", "Drug ID", "e.g. PCM500")}
+          {textField("name", "Drug name", "e.g. Paracetamol 500mg")}
+          {textField("brandName", "Brand name", "e.g. Panadol")}
+          {textField("pieceName", "Pieces are called", "e.g. tablets, capsules, ml")}
+        </div>
+        <FormField
+          control={form.control}
+          name="manufacturer"
+          render={({ field }) => (
+            <FormItem>
+              <FormLabel>Manufacturer details</FormLabel>
+              <FormControl>
+                <Textarea {...field} rows={2} placeholder="Name, address, contact" />
+              </FormControl>
+              <FormMessage />
+            </FormItem>
+          )}
+        />
+        <div className="grid gap-6 sm:grid-cols-[auto_1fr]">
+          <div className="space-y-2">
+            <div className="text-sm font-medium">Drug picture</div>
+            <ImagePicker images={mainImage} onChange={setMainImage} max={1} label="Add" />
+          </div>
+          <div className="space-y-2">
+            <div className="text-sm font-medium">Packaging pictures (e.g. blister)</div>
+            <ImagePicker images={packaging} onChange={setPackaging} max={MAX_PACKAGING_IMAGES} label="Add" />
+          </div>
+        </div>
+        <div className="space-y-2">
+          <div className="text-sm font-medium">Barcodes, package forms and stock</div>
+          <p className="text-xs text-muted-foreground">
+            Package form is quantity per base unit x number of base units, e.g. 10/Strip x10. Stock is how many of that package form you hold.
+          </p>
+          <PackageRowsEditor control={form.control} />
+        </div>
+        <DialogFooter>
+          <Button type="button" variant="ghost" onClick={onDone}>
+            Cancel
+          </Button>
+          <Button type="submit" disabled={form.formState.isSubmitting}>
+            {form.formState.isSubmitting && <Spinner />}
+            {drug ? "Save changes" : "Add drug"}
+          </Button>
+        </DialogFooter>
+      </form>
+    </Form>
+  );
+}
+
+export default function DrugFormDialog({ open, onOpenChange, drug }: Props) {
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="max-h-[92vh] overflow-y-auto sm:max-w-2xl">
+        <DialogHeader>
+          <DialogTitle>{drug ? `Edit ${drug.name}` : "Add drug"}</DialogTitle>
+        </DialogHeader>
+        {open && <DrugForm key={drug?._id ?? "new"} drug={drug} onDone={() => onOpenChange(false)} />}
+      </DialogContent>
+    </Dialog>
+  );
+}
