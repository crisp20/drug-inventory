diff --git a/convex/schema/drugs.ts b/convex/schema/drugs.ts
new file mode 100644
index 0000000..ae70e00
--- /dev/null
+++ b/convex/schema/drugs.ts
@@ -0,0 +1,43 @@
+import { defineTable } from "convex/server";
+import { v } from "convex/values";
+
+export const baseUnit = v.union(
+  v.literal("Strip"),
+  v.literal("Box"),
+  v.literal("Bottle"),
+  v.literal("Bag"),
+);
+
+export const drugsTable = defineTable({
+  // User/file-provided identifier, never generated by the system
+  drugId: v.string(),
+  name: v.string(),
+  brandName: v.string(),
+  manufacturer: v.string(),
+  // What individual pieces are called (tablets, capsules, ml...)
+  pieceName: v.string(),
+  imageId: v.optional(v.id("_storage")),
+  // Capped at MAX_PACKAGING_IMAGES in mutations
+  packagingImageIds: v.array(v.id("_storage")),
+  // Denormalized text for the search index (Drug ID, names)
+  searchText: v.string(),
+  updatedAt: v.string(),
+})
+  .index("by_drugId", ["drugId"])
+  .index("by_name", ["name"])
+  .searchIndex("search_text", { searchField: "searchText" });
+
+// One row per barcode. Each barcode has its own package form and stock amount.
+export const drugPackagesTable = defineTable({
+  drugRef: v.id("drugs"),
+  barcode: v.string(),
+  // Normalized lookup key (GTIN-14 for numeric codes)
+  barcodeKey: v.string(),
+  qtyPerUnit: v.number(),
+  baseUnit: baseUnit,
+  unitCount: v.number(),
+  // Number of complete package forms on hand
+  stock: v.number(),
+})
+  .index("by_drug", ["drugRef"])
+  .index("by_barcodeKey", ["barcodeKey"]);
