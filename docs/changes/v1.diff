@@ -0,0 +1,54 @@
+import { useCallback, useState } from "react";
+import { ScanLine, Search, X } from "lucide-react";
+import { Button } from "@/components/ui/button.tsx";
+import { Input } from "@/components/ui/input.tsx";
+import BarcodeScannerDialog from "./barcode-scanner-dialog.tsx";
+
+type Props = {
+  value: string;
+  onChange: (value: string) => void;
+  placeholder?: string;
+  autoFocus?: boolean;
+};
+
+// Works with keyboards, USB/Bluetooth scanners (they type + Enter) and the camera
+export default function DrugSearchInput({ value, onChange, placeholder, autoFocus }: Props) {
+  const [scanning, setScanning] = useState(false);
+  const handleDetected = useCallback(
+    (code: string) => {
+      setScanning(false);
+      onChange(code);
+    },
+    [onChange],
+  );
+
+  return (
+    <div className="flex gap-2">
+      <div className="relative flex-1">
+        <Search className="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
+        <Input
+          value={value}
+          autoFocus={autoFocus}
+          onChange={(e) => onChange(e.target.value)}
+          placeholder={placeholder ?? "Scan or search barcode, GS1 code, drug name, brand or Drug ID"}
+          className="h-11 bg-card pl-9 pr-9"
+        />
+        {value && (
+          <button
+            type="button"
+            onClick={() => onChange("")}
+            className="absolute right-3 top-1/2 -translate-y-1/2 cursor-pointer text-muted-foreground hover:text-foreground"
+            aria-label="Clear search"
+          >
+            <X className="size-4" />
+          </button>
+        )}
+      </div>
+      <Button type="button" size="lg" className="h-11" onClick={() => setScanning(true)}>
+        <ScanLine />
+        <span className="hidden sm:inline">Scan</span>
+      </Button>
+      <BarcodeScannerDialog open={scanning} onOpenChange={setScanning} onDetected={handleDetected} />
+    </div>
+  );
+}
