diff --git a/src/pages/inventory/_components/import-drop-zone.tsx b/src/pages/inventory/_components/import-drop-zone.tsx
new file mode 100644
--- /dev/null
+++ b/src/pages/inventory/_components/import-drop-zone.tsx
@@ -0,0 +1,73 @@
+import { useState, type DragEvent } from "react";
+import { toast } from "sonner";
+import { Upload } from "lucide-react";
+import { Spinner } from "@/components/ui/spinner.tsx";
+import { cn } from "@/lib/utils.ts";
+
+const ACCEPTED = [".xlsx", ".csv"];
+
+const isAccepted = (file: File) => ACCEPTED.some((ext) => file.name.toLowerCase().endsWith(ext));
+
+export default function ImportDropZone({ reading, onFile }: { reading: boolean; onFile: (file: File) => void }) {
+  const [dragging, setDragging] = useState(false);
+
+  const pick = (file: File | undefined) => {
+    if (!file) return;
+    if (!isAccepted(file)) {
+      toast.error("Please use an Excel (.xlsx) or CSV file");
+      return;
+    }
+    onFile(file);
+  };
+
+  const onDragOver = (e: DragEvent<HTMLLabelElement>) => {
+    // preventDefault is required for the browser to allow a drop here
+    e.preventDefault();
+    e.dataTransfer.dropEffect = "copy";
+    if (!dragging) setDragging(true);
+  };
+
+  const onDragLeave = (e: DragEvent<HTMLLabelElement>) => {
+    // Ignore leave events fired when moving over child elements
+    if (e.currentTarget.contains(e.relatedTarget as Node | null)) return;
+    setDragging(false);
+  };
+
+  const onDrop = (e: DragEvent<HTMLLabelElement>) => {
+    e.preventDefault();
+    setDragging(false);
+    if (e.dataTransfer.files.length > 1) toast.info("Only the first file is used");
+    pick(e.dataTransfer.files[0]);
+  };
+
+  return (
+    <label
+      onDragOver={onDragOver}
+      onDragEnter={onDragOver}
+      onDragLeave={onDragLeave}
+      onDrop={onDrop}
+      className={cn(
+        "flex cursor-pointer flex-col items-center gap-3 rounded-xl border-2 border-dashed p-10 text-center transition-colors hover:border-primary/50 hover:bg-muted/40",
+        dragging && "border-primary bg-primary/10",
+        reading && "pointer-events-none opacity-60",
+      )}
+    >
+      {reading ? <Spinner /> : <Upload className="size-8 text-primary" />}
+      <div className="font-semibold">
+        {reading ? "Reading file…" : dragging ? "Drop the file here" : "Drag a file here, or click to choose"}
+      </div>
+      <div className="text-sm text-muted-foreground">
+        Excel (.xlsx) or CSV. Nothing is saved until you review and confirm.
+      </div>
+      <input
+        type="file"
+        accept={ACCEPTED.join(",")}
+        className="sr-only"
+        onChange={(e) => {
+          pick(e.target.files?.[0]);
+          e.target.value = "";
+        }}
+      />
+    </label>
+  );
+}