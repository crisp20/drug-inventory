@@ -0,0 +1,71 @@
+import { useState } from "react";
+import { formatPackageForm } from "@/convex/lib/barcode.ts";
+import type { MovementKind } from "@/convex/lib/stock.ts";
+import { Label } from "@/components/ui/label.tsx";
+import { Switch } from "@/components/ui/switch.tsx";
+import MovementLog, { type MovementLogFilter } from "./movement-log.tsx";
+import type { StockSelection } from "./stock-drug-finder.tsx";
+
+type Props = {
+  kind: MovementKind;
+  title: string;
+  selection: StockSelection | null;
+  barcodeMatched: boolean;
+};
+
+// Recent entries; narrowed to the selected drug, or to its package form via the switch
+export default function MovementLogSection({ kind, title, selection, barcodeMatched }: Props) {
+  return (
+    <section className="space-y-3 pt-6">
+      {selection ? (
+        // Re-key so a scanned barcode starts narrowed to that package form each time
+        <FilteredLog
+          key={`${selection.pkg._id}-${barcodeMatched}`}
+          kind={kind}
+          title={title}
+          selection={selection}
+          defaultPackageOnly={barcodeMatched}
+        />
+      ) : (
+        <>
+          <h2 className="text-lg font-bold">{title}</h2>
+          <MovementLog kind={kind} />
+        </>
+      )}
+    </section>
+  );
+}
+
+type FilteredProps = { kind: MovementKind; title: string; selection: StockSelection; defaultPackageOnly: boolean };
+
+function FilteredLog({ kind, title, selection, defaultPackageOnly }: FilteredProps) {
+  const { drug, pkg } = selection;
+  const [packageOnly, setPackageOnly] = useState(defaultPackageOnly);
+  const filter: MovementLogFilter = packageOnly
+    ? { type: "package", packageId: pkg._id }
+    : { type: "drug", drugId: drug._id };
+  const switchId = `package-only-${kind}`;
+
+  return (
+    <>
+      <div className="flex flex-wrap items-end justify-between gap-x-4 gap-y-2">
+        <div className="min-w-0">
+          <h2 className="text-lg font-bold">{title}</h2>
+          <p className="truncate text-sm text-muted-foreground">
+            {drug.name} · <span className="font-mono">{drug.drugId}</span>
+            {packageOnly && <> · {formatPackageForm(pkg)}</>}
+          </p>
+        </div>
+        {drug.packages.length > 1 && (
+          <div className="flex items-center gap-2">
+            <Switch id={switchId} checked={packageOnly} onCheckedChange={setPackageOnly} className="cursor-pointer" />
+            <Label htmlFor={switchId} className="cursor-pointer text-sm">
+              Only {formatPackageForm(pkg)}
+            </Label>
+          </div>
+        )}
+      </div>
+      <MovementLog kind={kind} filter={filter} />
+    </>
+  );
+}
