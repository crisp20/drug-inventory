+++ b/src/lib/scanner-input.test.ts
@@ -0,0 +1,100 @@
+import { describe, expect, it } from "vitest";
+import {
+  addKey,
+  hasNonAscii,
+  keyFromCode,
+  scanResult,
+  type Burst,
+} from "./scanner-input.ts";
+
+const plain = { shift: false, ctrl: false, capsLock: false };
+const shifted = { ...plain, shift: true };
+
+// Feeds physical key codes as a scanner would (fast) and returns the burst
+function typeCodes(
+  codes: Array<[string, typeof plain]>,
+  gapMs: number,
+  start: Burst | null = null,
+  value = "",
+) {
+  return codes.reduce<Burst | null>(
+    (burst, [code, mods], i) =>
+      addKey(burst, keyFromCode(code, mods), 1000 + i * gapMs, value),
+    start,
+  );
+}
+
+describe("keyFromCode", () => {
+  it("rebuilds US keys from the physical key, whatever language is on", () => {
+    expect(keyFromCode("Digit0", plain)).toBe("0");
+    expect(keyFromCode("KeyA", plain)).toBe("a");
+    expect(keyFromCode("KeyA", shifted)).toBe("A");
+    expect(keyFromCode("Digit9", shifted)).toBe("(");
+    expect(keyFromCode("Digit0", shifted)).toBe(")");
+    expect(keyFromCode("Numpad7", plain)).toBe("7");
+  });
+
+  it("treats Ctrl+] as the GS1 separator and ignores other shortcuts", () => {
+    expect(keyFromCode("BracketRight", { ...plain, ctrl: true })).toBe(
+      String.fromCharCode(29),
+    );
+    expect(keyFromCode("KeyC", { ...plain, ctrl: true })).toBeNull();
+  });
+
+  it("returns null for editing keys", () => {
+    expect(keyFromCode("Backspace", plain)).toBeNull();
+    expect(keyFromCode("ArrowLeft", plain)).toBeNull();
+  });
+});
+
+describe("scan bursts", () => {
+  const gs1: Array<[string, typeof plain]> = [
+    ["Digit9", shifted],
+    ["Digit0", plain],
+    ["Digit1", plain],
+    ["Digit0", shifted],
+    ["Digit0", plain],
+    ["Digit9", plain],
+    ["Digit3", plain],
+    ["KeyL", shifted],
+    ["KeyC", shifted],
+  ];
+
+  it("rebuilds a fast scan exactly, including letters a Chinese keyboard would swallow", () => {
+    expect(scanResult(typeCodes(gs1, 5))).toEqual({
+      text: "(01)093LC",
+      incomplete: false,
+    });
+  });
+
+  it("ignores normal-speed typing", () => {
+    expect(scanResult(typeCodes(gs1, 150))).toBeNull();
+  });
+
+  it("ignores short bursts", () => {
+    expect(scanResult(typeCodes(gs1.slice(0, 3), 5))).toBeNull();
+  });
+
+  it("keeps text that was already in the box before the scan", () => {
+    expect(scanResult(typeCodes(gs1, 5, null, "abc"))?.text).toBe(
+      "abc(01)093LC",
+    );
+  });
+
+  it("flags keys the browser could not identify", () => {
+    const burst = typeCodes(gs1, 5);
+    const withUnknown = addKey(burst, null, 1000 + gs1.length * 5, "");
+    expect(scanResult(withUnknown)?.incomplete).toBe(true);
+  });
+});
+
+describe("hasNonAscii", () => {
+  it("spots Chinese or wide characters but allows the GS1 separator", () => {
+    expect(hasNonAscii("0109312345678907")).toBe(false);
+    expect(hasNonAscii(`0109312345678907${String.fromCharCode(29)}21X`)).toBe(
+      false,
+    );
+    expect(hasNonAscii("01093日月")).toBe(true);
+    expect(hasNonAscii("０１")).toBe(true);
+  });
+});
diff --git a/src/lib/scanner-input.ts b/src/lib/scanner-input.ts
new file mode 100644
index 0000000..1914013
--- /dev/null
+++ b/src/lib/scanner-input.ts
@@ -0,0 +1,115 @@
+// Barcode scanners act like a very fast keyboard. When a Chinese input method
+// (Pinyin, Cangjie, Sucheng...) is on, it swallows or changes those keystrokes.
+// KeyboardEvent.code always reports the physical key, so we rebuild what the
+// scanner actually typed (US layout, which is what scanners emulate).
+
+// Keys from a scanner arrive a few ms apart; people type ~100ms+ apart
+export const SCAN_MAX_GAP_MS = 50;
+// Shortest real barcode (EAN-8) is 8 characters; 6 keeps a safety margin
+export const SCAN_MIN_KEYS = 6;
+// Silence after the last key that means the scan is finished
+export const SCAN_END_MS = 100;
+
+const DIGIT_SHIFTED = ")!@#$%^&*(";
+const SYMBOLS: Record<string, [string, string]> = {
+  Minus: ["-", "_"],
+  Equal: ["=", "+"],
+  BracketLeft: ["[", "{"],
+  BracketRight: ["]", "}"],
+  Backslash: ["\\", "|"],
+  Semicolon: [";", ":"],
+  Quote: ["'", '"'],
+  Comma: [",", "<"],
+  Period: [".", ">"],
+  Slash: ["/", "?"],
+  Backquote: ["`", "~"],
+  Space: [" ", " "],
+};
+const NUMPAD: Record<string, string> = {
+  NumpadDecimal: ".",
+  NumpadSubtract: "-",
+  NumpadAdd: "+",
+  NumpadMultiply: "*",
+  NumpadDivide: "/",
+};
+const MODIFIERS = new Set([
+  "ShiftLeft",
+  "ShiftRight",
+  "ControlLeft",
+  "ControlRight",
+  "AltLeft",
+  "AltRight",
+  "MetaLeft",
+  "MetaRight",
+  "CapsLock",
+]);
+// GS1 group separator; many scanners send it as Ctrl+]
+const GS1_SEPARATOR = String.fromCharCode(29);
+
+export function isModifierCode(code: string): boolean {
+  return MODIFIERS.has(code);
+}
+
+type Mods = { shift: boolean; ctrl: boolean; capsLock: boolean };
+
+// Character a US keyboard would type for this physical key, or null if it's not a typing key
+export function keyFromCode(
+  code: string,
+  { shift, ctrl, capsLock }: Mods,
+): string | null {
+  if (ctrl) return code === "BracketRight" ? GS1_SEPARATOR : null;
+  const letter = code.match(/^Key([A-Z])$/);
+  if (letter) return shift !== capsLock ? letter[1] : letter[1].toLowerCase();
+  const digit = code.match(/^Digit(\d)$/);
+  if (digit) return shift ? DIGIT_SHIFTED[Number(digit[1])] : digit[1];
+  const pad = code.match(/^Numpad(\d)$/);
+  if (pad) return pad[1];
+  if (code in NUMPAD) return NUMPAD[code];
+  const sym = SYMBOLS[code];
+  return sym ? sym[shift ? 1 : 0] : null;
+}
+
+export type Burst = {
+  // Text in the box before the burst started
+  prefix: string;
+  chars: string[];
+  lastAt: number;
+  // A key arrived whose physical position the browser didn't report
+  incomplete: boolean;
+};
+
+// Adds one keystroke; a long pause starts a new burst
+export function addKey(
+  burst: Burst | null,
+  char: string | null,
+  now: number,
+  value: string,
+): Burst {
+  const current =
+    burst && now - burst.lastAt <= SCAN_MAX_GAP_MS
+      ? burst
+      : { prefix: value, chars: [], lastAt: now, incomplete: false };
+  return char === null
+    ? { ...current, lastAt: now, incomplete: true }
+    : { ...current, chars: [...current.chars, char], lastAt: now };
+}
+
+// The rebuilt text if the burst was fast and long enough to be a scanner
+export function scanResult(
+  burst: Burst | null,
+): { text: string; incomplete: boolean } | null {
+  if (!burst || burst.chars.length < SCAN_MIN_KEYS) return null;
+  return {
+    text: burst.prefix + burst.chars.join(""),
+    incomplete: burst.incomplete,
+  };
+}
+
+// Chinese, wide or other non-keyboard characters left in a barcode mean the scan went wrong
+export function hasNonAscii(text: string): boolean {
+  // Allow printable keyboard characters plus the GS1 separator (code 29)
+  return [...text].some((c) => {
+    const n = c.charCodeAt(0);
+    return n !== 29 && (n < 0x20 || n > 0x7e);
+  });
+}
