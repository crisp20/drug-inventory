+function Gallery({ slides, startIndex }: { slides: GallerySlide[]; startIndex: number }) {
+  const [api, setApi] = useState<CarouselApi>();
+  const [current, setCurrent] = useState(startIndex);
+  const multiple = slides.length > 1;
+
+  // Keep the caption/counter in sync with the carousel position
+  useEffect(() => {
+    if (!api) return;
+    const onSelect = () => setCurrent(api.selectedScrollSnap());
+    api.on("select", onSelect);
+    return () => {
+      api.off("select", onSelect);
+    };
+  }, [api]);
+
+  const slide = slides[current] ?? slides[0];
+
+  return (
+    <div className="space-y-2">
+      <Carousel setApi={setApi} opts={{ startIndex }}>
+        <CarouselContent>
+          {slides.map((s, i) => (
+            <CarouselItem key={`${s.url}-${i}`}>
+              <img src={s.url} alt={s.caption} className="max-h-[65vh] w-full rounded-lg bg-muted object-contain" />
+            </CarouselItem>
+          ))}
+        </CarouselContent>
+      </Carousel>
+      <div className="flex items-center gap-2">
+        {multiple && (
+          <Button
+            type="button"
+            variant="secondary"
+            size="icon"
+            className="size-9 shrink-0 rounded-full"
+            onClick={() => api?.scrollPrev()}
+            disabled={current === 0}
+            aria-label="Previous picture"
+          >
+            <ChevronLeft />
+          </Button>
+        )}
+        <div className="min-w-0 flex-1 text-center">
+          <div className="truncate font-semibold">{slide.caption}</div>
+          {multiple && (
+            <div className="text-xs text-muted-foreground">
+              {current + 1} / {slides.length}
+            </div>
+          )}
+        </div>
+        {multiple && (
+          <Button
+            type="button"
+            variant="secondary"
+            size="icon"
+            className="size-9 shrink-0 rounded-full"
+            onClick={() => api?.scrollNext()}
+            disabled={current === slides.length - 1}
+            aria-label="Next picture"
+          >
+            <ChevronRight />
+          </Button>
+        )}
+      </div>
+    </div>
+  );
+}
