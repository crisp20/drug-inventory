+import { useEffect, useRef, useState } from "react";
+import { Bluetooth, Minus, Plus, Printer, RotateCcw } from "lucide-react";
+import { toast } from "sonner";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog.tsx";
+import { Button } from "@/components/ui/button.tsx";
+import { Input } from "@/components/ui/input.tsx";
+import { Spinner } from "@/components/ui/spinner.tsx";
+import { ToggleGroup, ToggleGroupItem } from "@/components/ui/toggle-group.tsx";
+import {
+  bluetoothSupported,
+  connectPrinter,
+  forgetPrinter,
+  printerConnected,
+  printerName,
+} from "@/lib/label/bluetooth-printer.ts";
+import {
+  isLabelOrientation,
+  LABEL_ORIENTATIONS,
+  LABEL_SIZES,
+  loadLabelOrientation,
+  saveLabelOrientation,
+  type LabelOrientation,
+} from "@/lib/label/label-sizes.ts";
+import {
+  orientCanvas,
+  printCanvasBluetooth,
+  printCanvasWindow,
+} from "@/lib/label/print-label.ts";
+import { renderStockInLabel } from "@/lib/label/render-stock-in.ts";
+import {
+  MAX_LABEL_COPIES,
+  type StockInLabelData,
+} from "@/lib/label/stock-in-label.ts";
+import { errorMessage } from "@/lib/errors.ts";
+
+// Stock In labels are always 40 x 60 mm
+const SIZE = LABEL_SIZES["40x60"];
+const PREVIEW_CLASS: Record<LabelOrientation, string> = {
+  portrait: "h-[300px] w-[200px]",
+  landscape: "h-[200px] w-[300px]",
+};
+const TOGGLE_ITEM_CLASS =
+  "cursor-pointer data-[state=on]:bg-primary data-[state=on]:text-primary-foreground";
+
+type Status =
+  | { state: "drawing" }
+  | { state: "ready" }
+  | { state: "printing" }
+  | { state: "printed"; copies: number }
+  | { state: "failed"; message: string };
+
+type Props = {
+  data: StockInLabelData | null;
+  // Starting number of labels (usually the quantity received)
+  copies: number;
+  title: string;
+  onClose: () => void;
+};
+
+// Previews the Stock In label and prints the chosen number of copies.
+// Never prints by itself, so the count can be checked first.
+export default function StockInLabelDialog({
+  data,
+  copies,
+  title,
+  onClose,
+}: Props) {
+  return (
+    <Dialog open={data !== null} onOpenChange={(open) => !open && onClose()}>
+      <DialogContent className="sm:max-w-md">
+        {data && (
+          <StockInLabelPrinter
+            key={JSON.stringify(data)}
+            data={data}
+            initialCopies={copies}
+            title={title}
+          />
+        )}
+      </DialogContent>
+    </Dialog>
+  );
+}
+
+function clampCopies(n: number): number {
+  return Math.min(MAX_LABEL_COPIES, Math.max(1, Math.floor(n) || 1));
+}
+
+function StockInLabelPrinter({
+  data,
+  initialCopies,
+  title,
+}: {
+  data: StockInLabelData;
+  initialCopies: number;
+  title: string;
+}) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const [preview, setPreview] = useState<string | null>(null);
+  const [status, setStatus] = useState<Status>({ state: "drawing" });
+  const [orientation, setOrientation] = useState<LabelOrientation>(() =>
+    loadLabelOrientation(SIZE.id),
+  );
+  // Kept as typed text so the box can be cleared while typing
+  const [copiesText, setCopiesText] = useState(
+    String(clampCopies(initialCopies)),
+  );
+  const copies = clampCopies(Number(copiesText));
+  const canBluetooth = bluetoothSupported();
+
+  const changeOrientation = (value: string) => {
+    if (!isLabelOrientation(value) || value === orientation) return;
+    saveLabelOrientation(SIZE.id, value);
+    setPreview(null);
+    setStatus({ state: "drawing" });
+    setOrientation(value);
+  };
+
+  useEffect(() => {
+    let cancelled = false;
+    void renderStockInLabel(data, SIZE).then((drawn) => {
+      if (cancelled) return;
+      const canvas = orientCanvas(drawn, orientation);
+      canvasRef.current = canvas;
+      setPreview(canvas.toDataURL("image/png"));
+      setStatus({ state: "ready" });
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [data, orientation]);
+
+  const printBluetooth = async () => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    setStatus({ state: "printing" });
+    try {
+      await connectPrinter();
+      await printCanvasBluetooth(canvas, copies);
+      setStatus({ state: "printed", copies });
+      toast.success(
+        `${copies} label${copies === 1 ? "" : "s"} sent to the printer`,
+      );
+    } catch (e) {
+      const cancelled = e instanceof DOMException && e.name === "NotFoundError";
+      setStatus({
+        state: "failed",
+        message: cancelled
+          ? "No printer was chosen."
+          : errorMessage(e, "Could not print the labels"),
+      });
+    }
+  };
+
+  const printWindow = () => {
+    if (!canvasRef.current) return;
+    try {
+      printCanvasWindow(canvasRef.current, copies);
+    } catch (e) {
+      toast.error(errorMessage(e, "Could not open the print window"));
+    }
+  };
+
+  const busy = status.state === "drawing" || status.state === "printing";
+  const name = printerName();
+
+  return (
+    <>
+      <DialogHeader>
+        <DialogTitle>{title}</DialogTitle>
+        <DialogDescription>
+          {status.state === "printed"
+            ? `${status.copies} label${status.copies === 1 ? "" : "s"} printed${name ? ` on ${name}` : ""}.`
+            : status.state === "printing"
+              ? "Printing…"
+              : `40 × 60 mm label. ${canBluetooth ? "Connect the HPRT printer by Bluetooth, or use the print window." : "Use the print window with the printer paired to this device."}`}
+        </DialogDescription>
+      </DialogHeader>
+
+      <div className="flex items-center justify-between gap-3">
+        <label htmlFor="label-copies" className="text-sm font-medium">
+          Number of labels
+        </label>
+        <div className="flex items-center gap-1">
+          <Button
+            type="button"
+            variant="secondary"
+            size="icon"
+            aria-label="One fewer label"
+            disabled={copies <= 1 || status.state === "printing"}
+            onClick={() => setCopiesText(String(clampCopies(copies - 1)))}
+          >
+            <Minus />
+          </Button>
+          <Input
+            id="label-copies"
+            value={copiesText}
+            inputMode="numeric"
+            maxLength={3}
+            onChange={(e) => setCopiesText(e.target.value.replace(/\D/g, ""))}
+            onBlur={() => setCopiesText(String(copies))}
+            onFocus={(e) => e.target.select()}
+            className="h-9 w-16 text-center text-lg font-bold"
+          />
+          <Button
+            type="button"
+            variant="secondary"
+            size="icon"
+            aria-label="One more label"
+            disabled={copies >= MAX_LABEL_COPIES || status.state === "printing"}
+            onClick={() => setCopiesText(String(clampCopies(copies + 1)))}
+          >
+            <Plus />
+          </Button>
+        </div>
+      </div>
+
+      <div className="flex items-center justify-between gap-3">
+        <span className="text-sm font-medium">Direction</span>
+        <ToggleGroup
+          type="single"
+          variant="outline"
+          value={orientation}
+          onValueChange={changeOrientation}
+          disabled={status.state === "printing"}
+        >
+          {LABEL_ORIENTATIONS.map((o) => (
+            <ToggleGroupItem
+              key={o.id}
+              value={o.id}
+              className={TOGGLE_ITEM_CLASS}
+            >
+              {o.name}
+            </ToggleGroupItem>
+          ))}
+        </ToggleGroup>
+      </div>
+
+      <div className="flex justify-center rounded-lg bg-muted p-3">
+        {preview ? (
+          <img
+            src={preview}
+            alt={`Stock In label preview, ${orientation}`}
+            className={`${PREVIEW_CLASS[orientation]} rounded-sm bg-white shadow-sm [image-rendering:pixelated]`}
+          />
+        ) : (
+          <div
+            className={`${PREVIEW_CLASS[orientation]} flex items-center justify-center`}
+          >
+            <Spinner />
+          </div>
+        )}
+      </div>
+
+      {status.state === "failed" && (
+        <p className="rounded-md bg-destructive/10 px-3 py-2 text-sm text-destructive">
+          {status.message} Try again or use the print window.
+        </p>
+      )}
+
+      <DialogFooter className="gap-2 sm:justify-between">
+        <Button
+          type="button"
+          variant="ghost"
+          onClick={printWindow}
+          disabled={!preview}
+        >
+          <Printer />
+          Print window
+        </Button>
+        {canBluetooth && (
+          <div className="flex gap-2">
+            {name && (
+              <Button
+                type="button"
+                variant="ghost"
+                size="icon"
+                title="Choose a different printer"
+                disabled={busy}
+                onClick={() => {
+                  forgetPrinter();
+                  void printBluetooth();
+                }}
+              >
+                <RotateCcw />
+              </Button>
+            )}
+            <Button
+              type="button"
+              onClick={() => void printBluetooth()}
+              disabled={busy}
+            >
+              {status.state === "printing" ? <Spinner /> : <Bluetooth />}
+              {status.state === "printed" || status.state === "failed"
+                ? `Print ${copies} again`
+                : printerConnected()
+                  ? `Print ${copies}`
+                  : `Connect & print ${copies}`}
+            </Button>
+          </div>
+        )}
+      </DialogFooter>
+    </>
+  );
+}
