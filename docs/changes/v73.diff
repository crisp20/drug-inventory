+              Print
+              <span className="inline-flex h-6 min-w-6 items-center justify-center rounded-sm border-2 border-foreground px-1 text-sm font-bold">
+                8
+              </span>
+              on the labels
+            </FormLabel>
+          </FormItem>
+        )}
+      />
+    </div>
+  );
+}
diff --git a/src/lib/label/render-stock-in.ts b/src/lib/label/render-stock-in.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/label/render-stock-in.ts
@@ -0,0 +1,114 @@
+import { formatLabelDate } from "./label-data.ts";
+import {
+  drawPhotoInBox,
+  drawQr,
+  fitText,
+  FONT,
+  loadPhoto,
+  tagBox,
+  wrapLines,
+  type Ctx,
+} from "./draw.ts";
+import { drawLandscape } from "./render-compact.ts";
+import type { LabelSize } from "./label-sizes.ts";
+import {
+  stockInQrText,
+  stockInTags,
+  type StockInLabelData,
+} from "./stock-in-label.ts";
+
+// Laid out on the same 480 x 320 landscape grid as the Canister QR label (60 x 40 mm),
+// matching the ACP Stock In samples
+const LEFT = 10;
+const W = 480;
+
+// A medicine box with a capsule on it, like the samples' package icon
+function drawPackageIcon(ctx: Ctx, x: number, y: number, w: number, h: number) {
+  const lid = h * 0.28;
+  ctx.lineWidth = 4;
+  ctx.strokeStyle = "#000";
+  ctx.lineJoin = "round";
+  ctx.beginPath();
+  // Lid, slightly wider at the bottom
+  ctx.moveTo(x + 6, y);
+  ctx.lineTo(x + w - 6, y);
+  ctx.lineTo(x + w, y + lid);
+  ctx.lineTo(x, y + lid);
+  ctx.closePath();
+  ctx.rect(x + 2, y + lid, w - 4, h - lid);
+  ctx.stroke();
+  // Capsule turned at 45 degrees
+  const cx = x + w / 2;
+  const cy = y + lid + (h - lid) / 2;
+  const len = w * 0.42;
+  const r = h * 0.12;
+  ctx.save();
+  ctx.translate(cx, cy);
+  ctx.rotate(-Math.PI / 4);
+  ctx.beginPath();
+  ctx.arc(-len / 2 + r, 0, r, Math.PI / 2, (Math.PI * 3) / 2);
+  ctx.arc(len / 2 - r, 0, r, -Math.PI / 2, Math.PI / 2);
+  ctx.closePath();
+  ctx.lineWidth = 3;
+  ctx.stroke();
+  ctx.beginPath();
+  ctx.moveTo(0, -r);
+  ctx.lineTo(len / 2 - r, -r);
+  ctx.arc(len / 2 - r, 0, r, -Math.PI / 2, Math.PI / 2);
+  ctx.lineTo(0, r);
+  ctx.closePath();
+  ctx.fillStyle = "#000";
+  ctx.fill();
+  ctx.restore();
+}
+
+function drawStockIn(
+  ctx: Ctx,
+  scale: number,
+  data: StockInLabelData,
+  photo: HTMLCanvasElement | null,
+) {
+  const textW = W - LEFT * 2;
+  // Brand name over up to two lines, then the drug name in bold
+  ctx.font = `26px ${FONT}`;
+  const brand = wrapLines(ctx, data.brandName || data.name, textW, 2);
+  brand.forEach((line, i) =>
+    fitText(ctx, line, LEFT, 36 + i * 34, textW, 26, false, 14),
+  );
+  const nameY = brand.length > 1 ? 112 : 78;
+  fitText(ctx, data.name, LEFT, nameY, textW, 26, true, 14);
+
+  // Batch and expiry, only when entered
+  const extras = [
+    data.batch && `B:${data.batch}`,
+    data.expiry && `E:${formatLabelDate(data.expiry)}`,
+  ].filter((t): t is string => Boolean(t));
+  extras.forEach((t, i) =>
+    fitText(ctx, t, LEFT, 146 + i * 26, 230, 20, true, 11),
+  );
+
+  // Package icon and package form, above the QR code
+  drawPackageIcon(ctx, 254, 136, 54, 44);
+  fitText(ctx, data.packageForm, 320, 162, W - 320 - 6, 28, true, 14);
+
+  // Tablet photo
+  if (photo) drawPhotoInBox(ctx, photo, 12, 190, 220, 120);
+
+  // DDA and 8 boxes, stacked beside the QR code
+  stockInTags(data).forEach((t, i) =>
+    tagBox(ctx, t, 254, 194 + i * 46, 60, 40, 28),
+  );
+
+  drawQr(ctx, scale, stockInQrText(data), 324, 192, 116);
+}
+
+// Draws the Stock In label and returns it upright (portrait), like every design
+export async function renderStockInLabel(
+  data: StockInLabelData,
+  size: LabelSize,
+): Promise<HTMLCanvasElement> {
+  const photo = data.imageUrl ? await loadPhoto(data.imageUrl) : null;
+  return drawLandscape(size, (ctx, scale) =>
+    drawStockIn(ctx, scale, data, photo),
+  );
+}
diff --git a/src/lib/label/stock-in-label.test.ts b/src/lib/label/stock-in-label.test.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/label/stock-in-label.test.ts
@@ -0,0 +1,123 @@
+import { describe, expect, it } from "vitest";
+import {
+  defaultLabelCopies,
+  hasReprintableLabel,
+  MAX_LABEL_COPIES,
+  stockInLabelFromMovement,
+  stockInQrText,
+  stockInTags,
+} from "./stock-in-label.ts";
+import { buildCpclJob } from "./bitmap.ts";
+import { userInitials } from "@/convex/lib/initials.ts";
+
+describe("Stock In label", () => {
+  it("writes the QR text exactly like the ACP samples", () => {
+    expect(
+      stockInQrText({
+        drugId: "13103",
+        packageForm: "100/Box x1",
+        dangerousDrug: true,
+        initials: "HS",
+        eight: false,
+      }),
+    ).toBe("13103;100/Box x1;DDA_HS");
+    expect(
+      stockInQrText({
+        drugId: "5467",
+        packageForm: "28/Box x1",
+        dangerousDrug: false,
+        initials: "HS",
+        eight: true,
+      }),
+    ).toBe("5467;28/Box x1;_HS*");
+    expect(
+      stockInQrText({
+        drugId: "1",
+        packageForm: "60/Box x1",
+        dangerousDrug: true,
+        initials: "HS",
+        eight: true,
+      }),
+    ).toBe("1;60/Box x1;DDA_HS*");
+  });
+
+  it("stacks DDA above 8", () => {
+    expect(stockInTags({ dangerousDrug: true, eight: true })).toEqual([
+      "DDA",
+      "8",
+    ]);
+    expect(stockInTags({ dangerousDrug: false, eight: true })).toEqual(["8"]);
+    expect(stockInTags({ dangerousDrug: false, eight: false })).toEqual([]);
+  });
+
+  it("prints one label per package received, capped", () => {
+    expect(defaultLabelCopies(3)).toBe(3);
+    expect(defaultLabelCopies(5000)).toBe(MAX_LABEL_COPIES);
+  });
+
+  it("asks the printer for the number of copies", () => {
+    const text = new TextDecoder().decode(
+      buildCpclJob(new Uint8Array(16), 8, 2, 5),
+    );
+    expect(text.startsWith("! 0 200 200 2 5\r\n")).toBe(true);
+  });
+
+  it("uses admin-set initials before the name", () => {
+    expect(userInitials({ name: "Hubert Suen" })).toBe("HS");
+    expect(userInitials({ name: "Hubert Suen", initials: "HBS" })).toBe("HBS");
+    expect(userInitials(null)).toBe("");
+  });
+
+  it("rebuilds a reprint with the saved initials and 8 mark", () => {
+    const label = stockInLabelFromMovement(
+      {
+        drugCode: "13103",
+        brandName: "Lexotan 3mg Tab",
+        drugName: "Bromazepam 3mg Tab",
+        qtyPerUnit: 100,
+        baseUnit: "Box",
+        unitCount: 1,
+        userName: "Hubert Suen",
+        userInitials: "HBS",
+        eight: true,
+      },
+      null,
+      true,
+    );
+    expect(label).toMatchObject({
+      packageForm: "100/Box x1",
+      initials: "HBS",
+      eight: true,
+      dangerousDrug: true,
+    });
+    expect(
+      stockInLabelFromMovement(
+        {
+          drugCode: "1",
+          brandName: "",
+          drugName: "X",
+          qtyPerUnit: 1,
+          baseUnit: "Box",
+          unitCount: 1,
+          userName: "Mary Lee",
+        },
+        null,
+        false,
+      ).initials,
+    ).toBe("ML");
+  });
+
+  it("offers reprints only for canister fills and barcode-less Stock Ins", () => {
+    expect(hasReprintableLabel({ kind: "in", barcode: "" })).toBe(true);
+    expect(hasReprintableLabel({ kind: "in", barcode: "9312345678907" })).toBe(
+      false,
+    );
+    expect(hasReprintableLabel({ kind: "out", barcode: "" })).toBe(false);
+    expect(
+      hasReprintableLabel({ kind: "out", barcode: "1", canister: {} }),
+    ).toBe(true);
+    expect(hasReprintableLabel({ kind: "in", barcode: "", undo: {} })).toBe(
+      false,
+    );
+  });
+});
diff --git a/src/lib/label/stock-in-label.ts b/src/lib/label/stock-in-label.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/label/stock-in-label.ts
@@ -0,0 +1,98 @@
+import { formatPackageForm, type BaseUnit } from "@/convex/lib/barcode.ts";
+import { initialsOf } from "@/convex/lib/initials.ts";
+
+// Most labels sent in one go, so a mistyped count can't use up a roll
+export const MAX_LABEL_COPIES = 100;
+
+// Everything printed on a Stock In label (for package forms without a barcode)
+export type StockInLabelData = {
+  drugId: string;
+  brandName: string;
+  name: string;
+  // e.g. "100/Box x1"
+  packageForm: string;
+  // From the medicine's DDA mark
+  dangerousDrug: boolean;
+  // The "8" box ticked at Stock In
+  eight: boolean;
+  // e.g. "HS"
+  initials: string;
+  // Printed only when entered at Stock In
+  batch?: string;
+  // YYYY-MM-DD
+  expiry?: string;
+  imageUrl: string | null;
+};
+
+// QR text, matching the ACP samples: "<Drug ID>;<Package form>;<DDA>_<Initials><*>"
+// e.g. "13103;100/Box x1;DDA_HS" or "5467;28/Box x1;_HS*" (the * means the 8 box)
+export function stockInQrText(
+  data: Pick<
+    StockInLabelData,
+    "drugId" | "packageForm" | "dangerousDrug" | "initials" | "eight"
+  >,
+): string {
+  const marks = `${data.dangerousDrug ? "DDA" : ""}_${data.initials}${data.eight ? "*" : ""}`;
+  return [data.drugId, data.packageForm, marks].join(";");
+}
+
+// Boxes printed beside the QR code, top to bottom
+export function stockInTags(
+  data: Pick<StockInLabelData, "dangerousDrug" | "eight">,
+): string[] {
+  return [data.dangerousDrug && "DDA", data.eight && "8"].filter(
+    (t): t is string => Boolean(t),
+  );
+}
+
+// Labels to print by default: one per package received, up to the limit
+export function defaultLabelCopies(quantity: number): number {
+  return Math.min(MAX_LABEL_COPIES, Math.max(0, Math.floor(quantity)));
+}
+
+// The saved parts of a Stock In that a reprinted label needs
+export type StockInReprintSource = {
+  drugCode: string;
+  brandName: string;
+  drugName: string;
+  qtyPerUnit: number;
+  baseUnit: BaseUnit;
+  unitCount: number;
+  userName: string;
+  userInitials?: string;
+  eight?: boolean;
+  batch?: string;
+  expiry?: string;
+};
+
+// Entries that have a label to reprint: canister Stock Outs, and Stock Ins of
+// package forms without a barcode
+export function hasReprintableLabel(m: {
+  kind: "in" | "out";
+  barcode: string;
+  canister?: unknown;
+  undo?: unknown;
+}): boolean {
+  return !m.undo && (!!m.canister || (m.kind === "in" && !m.barcode.trim()));
+}
+
+// Rebuilds an earlier Stock In label with the original initials and 8 mark.
+// `dangerousDrug` is the medicine's current DDA mark (it isn't saved on the entry).
+export function stockInLabelFromMovement(
+  m: StockInReprintSource,
+  imageUrl: string | null,
+  dangerousDrug: boolean,
+): StockInLabelData {
+  return {
+    drugId: m.drugCode,
+    brandName: m.brandName,
+    name: m.drugName,
+    packageForm: formatPackageForm(m),
+    dangerousDrug,
+    eight: m.eight === true,
+    initials: m.userInitials || initialsOf(m.userName),
+    batch: m.batch,
+    expiry: m.expiry,
+    imageUrl,
+  };
+}
diff --git a/src/pages/users/_components/initials-field.tsx b/src/pages/users/_components/initials-field.tsx
