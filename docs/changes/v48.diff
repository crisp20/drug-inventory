diff --git a/src/lib/label/bitmap.ts b/src/lib/label/bitmap.ts
new file mode 100644
index 0000000..e60816a
--- /dev/null
+++ b/src/lib/label/bitmap.ts
@@ -0,0 +1,77 @@
+// Turns a grey-scale picture into the 1-bit image a thermal printer needs,
+// and wraps it in CPCL commands (the HPRT D35BT's printer language).
+
+// Floyd–Steinberg dithering so photos and the blue dot print as dot patterns.
+// Returns one value per pixel: 1 = black (burn), 0 = white.
+export function ditherToMono(
+  gray: Float32Array,
+  width: number,
+  height: number,
+): Uint8Array {
+  const g = Float32Array.from(gray);
+  const out = new Uint8Array(width * height);
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      const i = y * width + x;
+      const black = g[i] < 128;
+      out[i] = black ? 1 : 0;
+      const err = g[i] - (black ? 0 : 255);
+      if (x + 1 < width) g[i + 1] += (err * 7) / 16;
+      if (y + 1 < height) {
+        if (x > 0) g[i + width - 1] += (err * 3) / 16;
+        g[i + width] += (err * 5) / 16;
+        if (x + 1 < width) g[i + width + 1] += err / 16;
+      }
+    }
+  }
+  return out;
+}
+
+// Packs pixels 8 per byte, left pixel in the highest bit
+export function packRows(
+  mono: Uint8Array,
+  width: number,
+  height: number,
+): { bytesPerRow: number; data: Uint8Array } {
+  const bytesPerRow = Math.ceil(width / 8);
+  const data = new Uint8Array(bytesPerRow * height);
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      if (mono[y * width + x]) {
+        data[y * bytesPerRow + (x >> 3)] |= 0x80 >> (x & 7);
+      }
+    }
+  }
+  return { bytesPerRow, data };
+}
+
+// One CPCL label: the picture at the top-left, then feed to the next label gap
+export function buildCpclJob(
+  mono: Uint8Array,
+  width: number,
+  height: number,
+): Uint8Array {
+  const { bytesPerRow, data } = packRows(mono, width, height);
+  const enc = new TextEncoder();
+  const head = enc.encode(
+    `! 0 200 200 ${height} 1\r\nPAGE-WIDTH ${bytesPerRow * 8}\r\nCG ${bytesPerRow} ${height} 0 0 `,
+  );
+  const tail = enc.encode("\r\nFORM\r\nPRINT\r\n");
+  const job = new Uint8Array(head.length + data.length + tail.length);
+  job.set(head, 0);
+  job.set(data, head.length);
+  job.set(tail, head.length + data.length);
+  return job;
+}
+
+// Canvas pixels to grey-scale (transparent counts as white paper)
+export function toGray(rgba: Uint8ClampedArray): Float32Array {
+  const gray = new Float32Array(rgba.length / 4);
+  for (let i = 0; i < gray.length; i++) {
+    const a = rgba[i * 4 + 3] / 255;
+    const lum =
+      0.299 * rgba[i * 4] + 0.587 * rgba[i * 4 + 1] + 0.114 * rgba[i * 4 + 2];
+    gray[i] = lum * a + 255 * (1 - a);
+  }
+  return gray;
+}
diff --git a/src/lib/label/bluetooth-printer.ts b/src/lib/label/bluetooth-printer.ts
new file mode 100644
index 0000000..e1ef558
--- /dev/null
+++ b/src/lib/label/bluetooth-printer.ts
@@ -0,0 +1,99 @@
+// Direct Bluetooth printing (Chrome / Edge / Android). Safari and iPhone/iPad don't offer Web Bluetooth.
+
+// Serial-over-Bluetooth services used by HPRT and most label printers. The first
+// writable characteristic found is used to send the CPCL job.
+const PRINTER_SERVICES: BluetoothServiceUUID[] = [
+  "000018f0-0000-1000-8000-00805f9b34fb",
+  "e7810a71-73ae-499d-8c15-faa9aef0c3f2",
+  "49535343-fe7d-4ae5-8fa9-9fafd205e455",
+  "0000ff00-0000-1000-8000-00805f9b34fb",
+  "0000fee7-0000-1000-8000-00805f9b34fb",
+  "0000ae30-0000-1000-8000-00805f9b34fb",
+];
+
+const CHUNK_SIZE = 180;
+
+let device: BluetoothDevice | null = null;
+let writer: BluetoothRemoteGATTCharacteristic | null = null;
+
+export function bluetoothSupported(): boolean {
+  return typeof navigator !== "undefined" && "bluetooth" in navigator;
+}
+
+export function printerConnected(): boolean {
+  return writer !== null && device?.gatt?.connected === true;
+}
+
+export function printerName(): string | null {
+  return device?.name ?? null;
+}
+
+async function findWriter(
+  server: BluetoothRemoteGATTServer,
+): Promise<BluetoothRemoteGATTCharacteristic> {
+  const services = await server.getPrimaryServices();
+  for (const service of services) {
+    const chars = await service.getCharacteristics().catch(() => []);
+    const found = chars.find(
+      (c) => c.properties.writeWithoutResponse || c.properties.write,
+    );
+    if (found) return found;
+  }
+  throw new Error("This printer did not offer a way to receive labels");
+}
+
+async function attach(d: BluetoothDevice) {
+  if (!d.gatt) throw new Error("This device can't be used as a printer");
+  const server = await d.gatt.connect();
+  writer = await findWriter(server);
+  device = d;
+  d.addEventListener("gattserverdisconnected", () => {
+    writer = null;
+  });
+}
+
+// Reconnects to the last printer, or asks the user to pick one.
+// Picking needs a button press, so call this straight from a click.
+export async function connectPrinter(): Promise<void> {
+  if (!bluetoothSupported()) {
+    throw new Error("This browser can't connect to Bluetooth printers");
+  }
+  if (printerConnected()) return;
+  if (device) {
+    try {
+      await attach(device);
+      return;
+    } catch {
+      device = null;
+    }
+  }
+  const picked = await navigator.bluetooth.requestDevice({
+    acceptAllDevices: true,
+    optionalServices: PRINTER_SERVICES,
+  });
+  await attach(picked);
+}
+
+const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+export async function sendToPrinter(job: Uint8Array): Promise<void> {
+  if (!printerConnected()) await connectPrinter();
+  const w = writer;
+  if (!w) throw new Error("Printer is not connected");
+  for (let i = 0; i < job.length; i += CHUNK_SIZE) {
+    const chunk = job.slice(i, i + CHUNK_SIZE);
+    if (w.properties.writeWithoutResponse) {
+      await w.writeValueWithoutResponse(chunk);
+      // Small gap so the printer's buffer keeps up
+      await pause(8);
+    } else {
+      await w.writeValueWithResponse(chunk);
+    }
+  }
+}
+
+export function forgetPrinter() {
+  device?.gatt?.disconnect();
+  device = null;
+  writer = null;
+}
diff --git a/src/lib/label/label-data.ts b/src/lib/label/label-data.ts
new file mode 100644
index 0000000..0c8d9de
--- /dev/null
+++ b/src/lib/label/label-data.ts
@@ -0,0 +1,54 @@
+// Everything printed on a canister label (60mm x 40mm roll, printed 40mm wide x 60mm long)
+export type LabelData = {
+  drugId: string;
+  brandName: string;
+  name: string;
+  batch: string;
+  // YYYY-MM-DD
+  expiry: string;
+  canisterType: number;
+  // Initials of the person filling, e.g. "HS"
+  filledBy: string;
+  // YYMMDD, e.g. "261103"
+  fillDate: string;
+  // Drug ID for now; later a Canister ID from the canister server
+  qrText: string;
+  imageUrl: string | null;
+};
+
+const TYPE_LABELS: Record<string, string> = {
+  "1": "1",
+  "0.5": "Half",
+  "0.33": "Third",
+  "0.25": "Quarter",
+  "0.125": "Eighth",
+};
+
+export function canisterTypeLabel(type: number): string {
+  return TYPE_LABELS[String(type)] ?? String(type);
+}
+
+// "Hubert Suen" -> "HS"; falls back to the first letters of an email
+export function initialsOf(name: string | undefined): string {
+  const words = (name ?? "")
+    .replace(/@.*/, "")
+    .split(/[\s._-]+/)
+    .filter(Boolean);
+  if (words.length === 0) return "";
+  const letters =
+    words.length === 1
+      ? words[0].slice(0, 2)
+      : words[0][0] + words[words.length - 1][0];
+  return letters.toUpperCase();
+}
+
+// "2028-09-09" -> "2028/09/09"
+export function formatLabelDate(day: string): string {
+  return day.replaceAll("-", "/");
+}
+
+// Local date as YYMMDD, e.g. 3 Nov 2026 -> "261103"
+export function fillDateCode(date: Date): string {
+  const pad = (n: number) => String(n).padStart(2, "0");
+  return `${pad(date.getFullYear() % 100)}${pad(date.getMonth() + 1)}${pad(date.getDate())}`;
+}
diff --git a/src/lib/label/label.test.ts b/src/lib/label/label.test.ts
