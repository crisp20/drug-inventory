--- a/index.html
+++ b/index.html
@@ -31,6 +31,40 @@
       } catch (e) {}
     </script>
 
+    <!-- Old-browser check: written in old-style JavaScript so it still runs where the app itself can't.
+         The app needs about Chrome/Edge 111, Safari 16.4 or Firefox 114 (modern color features act as the test). -->
+    <script>
+      (function () {
+        var supported = false;
+        try {
+          supported =
+            !!window.CSS &&
+            CSS.supports("color", "oklch(0.5 0.1 300)") &&
+            CSS.supports("color", "color-mix(in srgb, red, blue)");
+        } catch (e) {}
+        if (supported) return;
+        window.__unsupportedBrowser = true;
+        function show() {
+          document.body.innerHTML =
+            '<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:#f7f4fb;font-family:Arial,Helvetica,sans-serif;color:#2a1340;box-sizing:border-box">' +
+            '<div style="max-width:460px;background:#fff;border:1px solid #e3dbee;border-radius:16px;padding:32px;text-align:center">' +
+            '<img src="https://hercules-cdn.com/file_1CrjBA7oz550P1YuXycIxorr" alt="ACP" width="56" height="56" style="border-radius:12px" />' +
+            '<h1 style="font-size:22px;margin:16px 0 8px">Please update your browser</h1>' +
+            '<p style="font-size:15px;line-height:1.5;color:#5c4a70;margin:0 0 16px">ACP Stock needs a newer browser to work. Please update to the latest version of Chrome, Edge, Safari or Firefox, or use another computer, tablet or phone.</p>' +
+            '<p style="font-size:13px;line-height:1.5;color:#5c4a70;margin:0 0 16px">Minimum: Chrome / Edge 111, Safari 16.4, Firefox 114.<br />Older Mac (macOS 10.12 to 10.14)? Install Firefox from mozilla.org.</p>' +
+            '<hr style="border:none;border-top:1px solid #e3dbee;margin:16px 0" />' +
+            '<h2 style="font-size:18px;margin:0 0 8px">請更新您的瀏覽器</h2>' +
+            '<p style="font-size:14px;line-height:1.6;color:#5c4a70;margin:0">ACP Stock 需要較新版本的瀏覽器。請更新至最新版本的 Chrome、Edge、Safari 或 Firefox，或改用其他電腦、平板或手機。</p>' +
+            "</div></div>";
+        }
+        if (document.readyState === "loading") {
+          document.addEventListener("DOMContentLoaded", show);
+        } else {
+          show();
+        }
+      })();
+    </script>
+
     <link href="/src/index.css" rel="stylesheet" />
   </head>
   <body>
