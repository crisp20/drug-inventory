+import { describe, expect, it } from "vitest";
+import {
+  builtScripts,
+  isNewVersion,
+  refreshReasonAt,
+  type RefreshCheckInput,
+} from "./refresh-check.ts";
+
+const NOW = 10_000_000;
+const base: RefreshCheckInput = {
+  now: NOW,
+  lastTick: NOW - 5_000,
+  lastActivity: NOW - 1_000,
+  idleTimeoutMinutes: 0,
+  disconnectedSince: null,
+};
+
+describe("refreshReasonAt", () => {
+  it("asks nothing while in use and connected", () => {
+    expect(refreshReasonAt(base)).toBeNull();
+  });
+
+  it("never times out when the idle setting is off", () => {
+    expect(refreshReasonAt({ ...base, lastActivity: 0 })).toBeNull();
+  });
+
+  it("times out after the set idle minutes, not before", () => {
+    const idle = { ...base, idleTimeoutMinutes: 30 };
+    expect(
+      refreshReasonAt({ ...idle, lastActivity: NOW - 29 * 60_000 }),
+    ).toBeNull();
+    expect(refreshReasonAt({ ...idle, lastActivity: NOW - 30 * 60_000 })).toBe(
+      "idle",
+    );
+  });
+
+  it("ignores short connection blips but not a lasting drop", () => {
+    expect(
+      refreshReasonAt({ ...base, disconnectedSince: NOW - 10_000 }),
+    ).toBeNull();
+    expect(refreshReasonAt({ ...base, disconnectedSince: NOW - 60_000 })).toBe(
+      "connection",
+    );
+  });
+
+  it("treats a long timer gap (device asleep) as a dropped connection", () => {
+    expect(refreshReasonAt({ ...base, lastTick: NOW - 10 * 60_000 })).toBe(
+      "connection",
+    );
+  });
+});
+
+describe("version check", () => {
+  const page = (src: string) =>
+    new DOMParser().parseFromString(
+      `<html><head><script type="module" crossorigin src="${src}"></script></head></html>`,
+      "text/html",
+    );
+
+  it("reads only built files", () => {
+    expect(builtScripts(page("/assets/index-abc.js"))).toEqual([
+      "/assets/index-abc.js",
+    ]);
+    expect(builtScripts(page("/src/main.tsx"))).toEqual([]);
+  });
+
+  it("spots a new publish and ignores the same or missing files", () => {
+    expect(isNewVersion(["/assets/a.js"], ["/assets/b.js"])).toBe(true);
+    expect(isNewVersion(["/assets/a.js"], ["/assets/a.js"])).toBe(false);
+    expect(isNewVersion([], ["/assets/b.js"])).toBe(false);
+    expect(isNewVersion(["/assets/a.js"], [])).toBe(false);
+  });
+});
diff --git a/src/lib/refresh-check.ts b/src/lib/refresh-check.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/refresh-check.ts
@@ -0,0 +1,72 @@
+// Decides when the app should ask the user to refresh the page.
+
+export type RefreshReason = "update" | "idle" | "connection";
+
+// A connection that stays down this long (e.g. the computer slept) needs a refresh
+export const CONNECTION_LOST_MS = 60_000;
+// The app's own timer runs every few seconds; a much longer gap means the device slept
+export const SLEEP_GAP_MS = 2 * 60_000;
+
+export type RefreshCheckInput = {
+  now: number;
+  // Last time the timer ran before this run
+  lastTick: number;
+  lastActivity: number;
+  // 0 = off
+  idleTimeoutMinutes: number;
+  // When the connection to the backend dropped; null while connected
+  disconnectedSince: number | null;
+};
+
+// Idle and connection checks (a new version is detected separately)
+export function refreshReasonAt(
+  input: RefreshCheckInput,
+): RefreshReason | null {
+  const { now, lastTick, lastActivity, idleTimeoutMinutes, disconnectedSince } =
+    input;
+  if (
+    idleTimeoutMinutes > 0 &&
+    now - lastActivity >= idleTimeoutMinutes * 60_000
+  ) {
+    return "idle";
+  }
+  if (
+    disconnectedSince !== null &&
+    now - disconnectedSince >= CONNECTION_LOST_MS
+  ) {
+    return "connection";
+  }
+  if (now - lastTick >= SLEEP_GAP_MS) return "connection";
+  return null;
+}
+
+// Built files (e.g. /assets/index-AbC123.js) change name on every publish.
+// Dev mode has no /assets/ scripts, so nothing is compared there.
+export function builtScripts(doc: Document): string[] {
+  return Array.from(doc.querySelectorAll("script[type='module'][src]"))
+    .map((s) => s.getAttribute("src") ?? "")
+    .filter((src) => src.includes("/assets/"));
+}
+
+export function isNewVersion(current: string[], latest: string[]): boolean {
+  return (
+    current.length > 0 &&
+    latest.length > 0 &&
+    latest.some((src) => !current.includes(src))
+  );
+}
+
+// Fetches the published page and compares its built files with the ones running now
+export async function checkForNewVersion(): Promise<boolean> {
+  const current = builtScripts(document);
+  if (current.length === 0) return false;
+  const res = await fetch(`/?version-check=${Date.now()}`, {
+    cache: "no-store",
+  });
+  if (!res.ok) return false;
+  const html = await res.text();
+  const latest = builtScripts(
+    new DOMParser().parseFromString(html, "text/html"),
+  );
+  return isNewVersion(current, latest);
+}
