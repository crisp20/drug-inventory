+import {
+  CloudOff,
+  Clock,
+  RefreshCw,
+  Sparkles,
+  type LucideIcon,
+} from "lucide-react";
+import {
+  AlertDialog,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from "@/components/ui/alert-dialog.tsx";
+import { Button } from "@/components/ui/button.tsx";
+import { useRefreshReminder } from "@/hooks/use-refresh-reminder.ts";
+import { useUnsavedChangesApi } from "@/hooks/use-unsaved-changes.ts";
+import type { RefreshReason } from "@/lib/refresh-check.ts";
+
+const COPY: Record<
+  RefreshReason,
+  { icon: LucideIcon; title: string; description: string }
+> = {
+  update: {
+    icon: Sparkles,
+    title: "A new version of ACP Stock is ready",
+    description:
+      "Refresh to start using the latest version. Older screens may not save entries correctly.",
+  },
+  idle: {
+    icon: Clock,
+    title: "Please refresh to continue",
+    description:
+      "ACP Stock has not been used for a while. Refresh to make sure you see the latest stock levels.",
+  },
+  connection: {
+    icon: CloudOff,
+    title: "The connection was lost",
+    description:
+      "The app lost its connection (for example, the computer went to sleep). Refresh to make sure you see the latest stock levels.",
+  },
+};
+
+// App-wide pop-up asking the user to refresh. It can't be closed, except to
+// finish a half-filled entry first.
+export default function RefreshReminder() {
+  const { reason, open, snooze } = useRefreshReminder();
+  const { hasUnsaved, clearAll } = useUnsavedChangesApi();
+  if (!reason) return null;
+  const copy = COPY[reason];
+  const unsaved = open && hasUnsaved();
+
+  const refresh = () => {
+    // The user already agreed below, so skip the browser's own "Leave site?" prompt
+    clearAll();
+    window.location.reload();
+  };
+
+  return (
+    <AlertDialog open={open}>
+      <AlertDialogContent onEscapeKeyDown={(e) => e.preventDefault()}>
+        <AlertDialogHeader>
+          <div className="mx-auto flex size-12 items-center justify-center rounded-full bg-accent text-accent-foreground sm:mx-0">
+            <copy.icon className="size-6" />
+          </div>
+          <AlertDialogTitle>{copy.title}</AlertDialogTitle>
+          <AlertDialogDescription>{copy.description}</AlertDialogDescription>
+        </AlertDialogHeader>
+        {unsaved && (
+          <p className="rounded-lg border border-destructive/40 bg-destructive/10 p-3 text-sm font-medium text-destructive">
+            You have an entry that hasn't been recorded yet. Finish and record
+            it first, or it will be lost when you refresh.
+          </p>
+        )}
+        <AlertDialogFooter>
+          {unsaved && (
+            <Button
+              variant="secondary"
+              onClick={snooze}
+              className="cursor-pointer"
+            >
+              Finish my entry first
+            </Button>
+          )}
+          <Button
+            variant={unsaved ? "destructive" : "default"}
+            onClick={refresh}
+            className="cursor-pointer"
+          >
+            <RefreshCw />
+            {unsaved ? "Refresh and lose entry" : "Refresh now"}
+          </Button>
+        </AlertDialogFooter>
+      </AlertDialogContent>
+    </AlertDialog>
+  );
+}
diff --git a/src/hooks/use-refresh-reminder.ts b/src/hooks/use-refresh-reminder.ts
new file mode 100644
--- /dev/null
+++ b/src/hooks/use-refresh-reminder.ts
@@ -0,0 +1,113 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useConvex, useQuery } from "convex/react";
+import { api } from "@/convex/_generated/api.js";
+import { useUnsavedChangesApi } from "@/hooks/use-unsaved-changes.ts";
+import {
+  checkForNewVersion,
+  refreshReasonAt,
+  type RefreshReason,
+} from "@/lib/refresh-check.ts";
+
+const TICK_MS = 5_000;
+// Look for a newly published version every 5 minutes (and whenever the tab comes back)
+const VERSION_CHECK_MS = 5 * 60_000;
+// "Finish my entry first" hides the reminder for this long
+export const SNOOZE_MS = 2 * 60_000;
+
+const ACTIVITY_EVENTS = [
+  "pointerdown",
+  "keydown",
+  "wheel",
+  "touchstart",
+] as const;
+
+// Watches for a new publish, the admin's idle time and a dropped connection.
+// Once a reason is found it stays until the page is refreshed.
+export function useRefreshReminder() {
+  const convex = useConvex();
+  const { hasUnsaved } = useUnsavedChangesApi();
+  const settings = useQuery(api.settings.get, {});
+  const idleTimeoutMinutes = settings?.idleTimeoutMinutes ?? 0;
+  const [reason, setReason] = useState<RefreshReason | null>(null);
+  const [open, setOpen] = useState(false);
+  const reasonRef = useRef<RefreshReason | null>(null);
+  const snoozeUntilRef = useRef(0);
+
+  // Timers, browser events and the backend connection are external systems
+  useEffect(() => {
+    let lastTick = Date.now();
+    let lastActivity = Date.now();
+    let lastVersionCheck = Date.now();
+    let disconnectedSince: number | null = null;
+
+    const flag = (r: RefreshReason) => {
+      if (!reasonRef.current) {
+        reasonRef.current = r;
+        setReason(r);
+      }
+      if (Date.now() >= snoozeUntilRef.current) setOpen(true);
+    };
+
+    const versionCheck = () => {
+      lastVersionCheck = Date.now();
+      checkForNewVersion()
+        .then((isNew) => isNew && flag("update"))
+        .catch(() => undefined);
+    };
+
+    const tick = () => {
+      const now = Date.now();
+      const r = refreshReasonAt({
+        now,
+        lastTick,
+        lastActivity,
+        idleTimeoutMinutes,
+        disconnectedSince,
+      });
+      lastTick = now;
+      if (r) flag(r);
+      // Snoozed to finish an entry: come back once it's recorded, or after the snooze
+      else if (
+        reasonRef.current &&
+        (now >= snoozeUntilRef.current || !hasUnsaved())
+      )
+        setOpen(true);
+      if (now - lastVersionCheck >= VERSION_CHECK_MS) versionCheck();
+    };
+
+    // Check first, so touching the screen after the idle limit still asks to refresh
+    const onActivity = () => {
+      tick();
+      lastActivity = Date.now();
+    };
+    const onVisible = () => {
+      if (document.visibilityState !== "visible") return;
+      tick();
+      versionCheck();
+    };
+
+    const unsubscribe = convex.subscribeToConnectionState((s) => {
+      if (!s.hasEverConnected) return;
+      if (s.isWebSocketConnected) disconnectedSince = null;
+      else disconnectedSince ??= Date.now();
+    });
+    const interval = window.setInterval(tick, TICK_MS);
+    for (const e of ACTIVITY_EVENTS)
+      window.addEventListener(e, onActivity, { passive: true });
+    document.addEventListener("visibilitychange", onVisible);
+    return () => {
+      unsubscribe();
+      window.clearInterval(interval);
+      for (const e of ACTIVITY_EVENTS)
+        window.removeEventListener(e, onActivity);
+      document.removeEventListener("visibilitychange", onVisible);
+    };
+  }, [convex, idleTimeoutMinutes, hasUnsaved]);
+
+  const snooze = useCallback(() => {
+    snoozeUntilRef.current = Date.now() + SNOOZE_MS;
+    setOpen(false);
+  }, []);
+
+  return { reason, open, snooze };
+}
