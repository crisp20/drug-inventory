@@ -0,0 +1,76 @@
+import { useState } from "react";
+import { Check, ChevronsUpDown, Plus } from "lucide-react";
+import { Button } from "@/components/ui/button.tsx";
+import {
+  Command,
+  CommandEmpty,
+  CommandGroup,
+  CommandInput,
+  CommandItem,
+  CommandList,
+} from "@/components/ui/command.tsx";
+import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover.tsx";
+import { MANUFACTURERS } from "@/lib/manufacturers.ts";
+import { cn } from "@/lib/utils.ts";
+
+type Props = {
+  value: string;
+  onChange: (value: string) => void;
+};
+
+// Searchable list of known manufacturers. A name that isn't listed can still be used.
+export default function ManufacturerPicker({ value, onChange }: Props) {
+  const [open, setOpen] = useState(false);
+  const [search, setSearch] = useState("");
+  const typed = search.trim();
+  const exactMatch = MANUFACTURERS.some((m) => m.toLowerCase() === typed.toLowerCase());
+
+  const choose = (name: string) => {
+    onChange(name === value ? "" : name);
+    setSearch("");
+    setOpen(false);
+  };
+
+  return (
+    // modal keeps scrolling working inside the drug form dialog
+    <Popover open={open} onOpenChange={setOpen} modal>
+      <PopoverTrigger asChild>
+        <Button
+          type="button"
+          variant="secondary"
+          role="combobox"
+          aria-expanded={open}
+          className="h-auto min-h-9 w-full justify-between whitespace-normal text-left font-normal"
+        >
+          <span className={cn("min-w-0 flex-1", !value && "text-muted-foreground")}>
+            {value || "Search and select a manufacturer"}
+          </span>
+          <ChevronsUpDown className="shrink-0 opacity-50" />
+        </Button>
+      </PopoverTrigger>
+      <PopoverContent className="w-(--radix-popover-trigger-width) min-w-72 p-0" align="start">
+        <Command>
+          <CommandInput placeholder="Type to search…" value={search} onValueChange={setSearch} />
+          <CommandList className="max-h-72">
+            <CommandEmpty>No manufacturer found.</CommandEmpty>
+            {typed && !exactMatch && (
+              <CommandGroup>
+                <CommandItem value={`__custom__ ${typed}`} onSelect={() => choose(typed)} className="cursor-pointer">
+                  <Plus /> Use “{typed}”
+                </CommandItem>
+              </CommandGroup>
+            )}
+            <CommandGroup>
+              {MANUFACTURERS.map((name) => (
+                <CommandItem key={name} value={name} onSelect={() => choose(name)} className="cursor-pointer">
+                  <Check className={cn(value === name ? "opacity-100" : "opacity-0")} />
+                  {name}
+                </CommandItem>
+              ))}
+            </CommandGroup>
+          </CommandList>
+        </Command>
+      </PopoverContent>
+    </Popover>
+  );
+}
