@@ -0,0 +1,235 @@
+import { useState, type KeyboardEvent } from "react";
+import { useFormContext, useWatch } from "react-hook-form";
+import { Camera, Pill } from "lucide-react";
+import { toast } from "sonner";
+import { barcodesMatch } from "@/convex/lib/barcode.ts";
+import { CANISTER_TYPES } from "@/convex/lib/canister.ts";
+import { parseGs1 } from "@/convex/lib/gs1.ts";
+import { Button } from "@/components/ui/button.tsx";
+import {
+  FormControl,
+  FormField,
+  FormItem,
+  FormLabel,
+  FormMessage,
+} from "@/components/ui/form.tsx";
+import { Input } from "@/components/ui/input.tsx";
+import {
+  NativeSelect,
+  NativeSelectOption,
+} from "@/components/ui/native-select.tsx";
+import { Switch } from "@/components/ui/switch.tsx";
+import BarcodeScannerDialog from "@/components/barcode-scanner-dialog.tsx";
+import { useScannerInput } from "@/hooks/use-scanner-input.ts";
+import type {
+  MovementFormInput,
+  MovementFormValues,
+} from "./movement-form-schema.ts";
+
+type Props = {
+  // Tablets/capsules in what is being taken out (used when Canister QTY is left blank)
+  autoQty: number;
+  pieceName: string;
+  packageBarcode: string;
+};
+
+const inputClass = "h-10 bg-background";
+
+// "Fill canister" switch plus Batch, Expiry, Canister QTY and Canister Type
+export default function CanisterSection({
+  autoQty,
+  pieceName,
+  packageBarcode,
+}: Props) {
+  const form = useFormContext<MovementFormInput, unknown, MovementFormValues>();
+  const on = useWatch({ control: form.control, name: "canisterOn" });
+  // Follows the quantity taken out until the user types their own number
+  const [qtyEdited, setQtyEdited] = useState(false);
+
+  return (
+    <div className="space-y-4 rounded-xl border border-dashed border-primary/40 bg-secondary/40 p-3">
+      <FormField
+        control={form.control}
+        name="canisterOn"
+        render={({ field }) => (
+          <FormItem className="flex items-center justify-between gap-3">
+            <FormLabel className="flex cursor-pointer items-center gap-2 text-base font-semibold">
+              <Pill className="size-4 text-primary" />
+              Fill canister
+            </FormLabel>
+            <FormControl>
+              <Switch
+                checked={field.value}
+                onCheckedChange={field.onChange}
+                className="cursor-pointer"
+              />
+            </FormControl>
+          </FormItem>
+        )}
+      />
+      {on && (
+        <>
+          <Gs1ScanBox packageBarcode={packageBarcode} />
+          <div className="grid gap-3 sm:grid-cols-2">
+            <FormField
+              control={form.control}
+              name="batch"
+              render={({ field }) => (
+                <FormItem>
+                  <FormLabel>Batch</FormLabel>
+                  <FormControl>
+                    <Input
+                      {...field}
+                      placeholder="e.g. 50803-3"
+                      className={inputClass}
+                    />
+                  </FormControl>
+                  <FormMessage />
+                </FormItem>
+              )}
+            />
+            <FormField
+              control={form.control}
+              name="expiry"
+              render={({ field }) => (
+                <FormItem>
+                  <FormLabel>Expiry</FormLabel>
+                  <FormControl>
+                    <Input {...field} type="date" className={inputClass} />
+                  </FormControl>
+                  <FormMessage />
+                </FormItem>
+              )}
+            />
+            <FormField
+              control={form.control}
+              name="canisterQty"
+              render={({ field }) => (
+                <FormItem>
+                  <FormLabel>Canister QTY ({pieceName || "pieces"})</FormLabel>
+                  <FormControl>
+                    <Input
+                      {...field}
+                      inputMode="numeric"
+                      placeholder={String(autoQty)}
+                      value={qtyEdited ? field.value : String(autoQty)}
+                      onChange={(e) => {
+                        setQtyEdited(true);
+                        field.onChange(
+                          e.target.value.replace(/\D/g, "").slice(0, 7),
+                        );
+                      }}
+                      onFocus={(e) => e.target.select()}
+                      className={inputClass}
+                    />
+                  </FormControl>
+                  <FormMessage />
+                </FormItem>
+              )}
+            />
+            <FormField
+              control={form.control}
+              name="canisterType"
+              render={({ field }) => (
+                <FormItem>
+                  <FormLabel>Canister Type</FormLabel>
+                  <FormControl>
+                    <NativeSelect
+                      {...field}
+                      className="h-10 w-full cursor-pointer bg-background"
+                    >
+                      {CANISTER_TYPES.map((t) => (
+                        <NativeSelectOption key={t} value={String(t)}>
+                          {t}
+                        </NativeSelectOption>
+                      ))}
+                    </NativeSelect>
+                  </FormControl>
+                  <FormMessage />
+                </FormItem>
+              )}
+            />
+          </div>
+        </>
+      )}
+    </div>
+  );
+}
+
+// Scan the box's GS1 code here to fill Batch and Expiry
+function Gs1ScanBox({ packageBarcode }: { packageBarcode: string }) {
+  const form = useFormContext<MovementFormInput, unknown, MovementFormValues>();
+  const [value, setValue] = useState("");
+  const [camera, setCamera] = useState(false);
+  const {
+    inputRef,
+    onKeyDown: scannerKeyDown,
+    setValue: setScanned,
+    display,
+  } = useScannerInput(setValue);
+
+  const apply = (code: string) => {
+    const data = parseGs1(code);
+    setValue("");
+    if (!data || (!data.batch && !data.expiry)) {
+      toast.error("No batch or expiry found in that code", {
+        description: "Scan the GS1 code (the square DataMatrix) on the box.",
+      });
+      return;
+    }
+    if (
+      data.gtin &&
+      packageBarcode &&
+      !barcodesMatch(data.gtin, packageBarcode)
+    ) {
+      toast.error("This code is for a different product", {
+        description: "Check you scanned the box for the selected package form.",
+      });
+      return;
+    }
+    const opts = { shouldDirty: true, shouldValidate: true };
+    if (data.batch) form.setValue("batch", data.batch, opts);
+    if (data.expiry) form.setValue("expiry", data.expiry, opts);
+    toast.success("Batch and expiry filled from scan");
+  };
+
+  const handleKeyDown = (e: KeyboardEvent<HTMLInputElement>) => {
+    const rebuilt = scannerKeyDown(e);
+    if (e.key !== "Enter") return;
+    // Enter here fills the fields; it must not record the Stock Out
+    e.preventDefault();
+    const code = rebuilt ?? e.currentTarget.value;
+    if (code.trim()) apply(code);
+  };
+
+  return (
+    <div className="flex gap-2">
+      <Input
+        ref={inputRef}
+        value={display(value)}
+        onChange={(e) => setScanned(e.target.value)}
+        onKeyDown={handleKeyDown}
+        placeholder="Scan GS1 code to fill batch and expiry"
+        aria-label="Scan GS1 code to fill batch and expiry"
+        className={inputClass}
+      />
+      <Button
+        type="button"
+        variant="secondary"
+        className="h-10 shrink-0"
+        onClick={() => setCamera(true)}
+        aria-label="Scan with camera"
+      >
+        <Camera />
+      </Button>
+      <BarcodeScannerDialog
+        open={camera}
+        onOpenChange={setCamera}
+        onDetected={(code) => {
+          setCamera(false);
+          apply(code);
+        }}
+      />
+    </div>
+  );
+}
