new file mode 100644
index 0000000..095e7d1
--- /dev/null
+++ b/convex/lib/canister.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import { gs1DateToDay, parseGs1 } from "./gs1";
+import { canisterQtyFor, canUseCanister, cleanCanisterInput } from "./canister";
+
+describe("parseGs1", () => {
+  it("reads batch and expiry from bracketed codes", () => {
+    expect(parseGs1("(01)09312345678907(17)280909(10)50803-3")).toEqual({
+      gtin: "09312345678907",
+      batch: "50803-3",
+      expiry: "2028-09-09",
+    });
+  });
+
+  it("reads raw DataMatrix codes with group separators", () => {
+    expect(
+      parseGs1("]d20109312345678907172809091050803-3\u001d21SERIAL1"),
+    ).toEqual({
+      gtin: "09312345678907",
+      batch: "50803-3",
+      expiry: "2028-09-09",
+    });
+  });
+
+  it("handles batch before expiry", () => {
+    expect(parseGs1("010931234567890710AB12\u001d17261231")).toMatchObject({
+      batch: "AB12",
+      expiry: "2026-12-31",
+    });
+  });
+
+  it("reads codes typed with a Chinese keyboard (full-width)", () => {
+    expect(parseGs1("（01）09312345678907（17）280909（10）X1")).toMatchObject({
+      batch: "X1",
+      expiry: "2028-09-09",
+    });
+  });
+
+  it("returns null for plain barcodes", () => {
+    expect(parseGs1("9312345678907")).toBeNull();
+  });
+});
+
+describe("gs1DateToDay", () => {
+  it("treats day 00 as the last day of the month", () => {
+    expect(gs1DateToDay("280200")).toBe("2028-02-29");
+  });
+  it("rejects impossible dates", () => {
+    expect(gs1DateToDay("281301")).toBeUndefined();
+  });
+});
+
+describe("canister rules", () => {
+  it("calculates tablets from package forms taken out", () => {
+    expect(canisterQtyFor(1, { qtyPerUnit: 100, unitCount: 1 })).toBe(100);
+    expect(canisterQtyFor(2, { qtyPerUnit: 10, unitCount: 10 })).toBe(200);
+  });
+
+  it("is hidden unless rolled out or switched on for the person", () => {
+    expect(canUseCanister({}, false)).toBe(false);
+    expect(canUseCanister({ canisterAccess: true }, false)).toBe(true);
+    expect(canUseCanister({ canisterAccess: false }, true)).toBe(true);
+  });
+
+  it("requires batch, valid expiry, qty and a listed type", () => {
+    const ok = {
+      batch: " B1 ",
+      expiry: "2028-09-09",
+      quantity: 100,
+      type: 0.5,
+    };
+    expect(cleanCanisterInput(ok).batch).toBe("B1");
+    expect(() => cleanCanisterInput({ ...ok, batch: " " })).toThrow();
+    expect(() => cleanCanisterInput({ ...ok, expiry: "2028-02-30" })).toThrow();
+    expect(() => cleanCanisterInput({ ...ok, quantity: 0 })).toThrow();
+    expect(() => cleanCanisterInput({ ...ok, type: 0.4 })).toThrow();
+  });
+});
diff --git a/convex/lib/canister.ts b/convex/lib/canister.ts
new file mode 100644
index 0000000..850698f
--- /dev/null
+++ b/convex/lib/canister.ts
@@ -0,0 +1,69 @@
+import { ConvexError } from "convex/values";
+import type { Doc } from "../_generated/dataModel";
+
+// Fraction of a tablet per canister slot, like the canister machine's own list
+export const CANISTER_TYPES = [1, 0.5, 0.33, 0.25, 0.125] as const;
+export const DEFAULT_CANISTER_TYPE = 1;
+export const MAX_BATCH_LENGTH = 40;
+export const MAX_CANISTER_QTY = 1_000_000;
+
+export type CanisterInput = {
+  batch: string;
+  expiry: string;
+  quantity: number;
+  type: number;
+};
+
+// Hidden until rolled out: on for everyone, or for people switched on individually
+export function canUseCanister(
+  user: Pick<Doc<"users">, "canisterAccess"> | null | undefined,
+  canisterForEveryone: boolean,
+): boolean {
+  return canisterForEveryone || user?.canisterAccess === true;
+}
+
+// Tablets/capsules going into the canister for this many package forms (e.g. 1 x 100/Box x1 = 100)
+export function canisterQtyFor(
+  quantity: number,
+  pkg: { qtyPerUnit: number; unitCount: number },
+): number {
+  return quantity * pkg.qtyPerUnit * pkg.unitCount;
+}
+
+export function isCalendarDay(value: string): boolean {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const [y, m, d] = value.split("-").map(Number);
+  const date = new Date(Date.UTC(y, m - 1, d));
+  return (
+    date.getUTCFullYear() === y &&
+    date.getUTCMonth() === m - 1 &&
+    date.getUTCDate() === d
+  );
+}
+
+function bad(message: string): never {
+  throw new ConvexError({ code: "BAD_REQUEST", message });
+}
+
+export function cleanCanisterInput(raw: CanisterInput): CanisterInput {
+  const batch = raw.batch.trim();
+  if (!batch) bad("Enter the batch number");
+  if (batch.length > MAX_BATCH_LENGTH)
+    bad(`Batch can be at most ${MAX_BATCH_LENGTH} characters`);
+  if (!isCalendarDay(raw.expiry)) bad("Enter a valid expiry date");
+  if (
+    !Number.isInteger(raw.quantity) ||
+    raw.quantity < 1 ||
+    raw.quantity > MAX_CANISTER_QTY
+  )
+    bad(
+      `Canister QTY must be a whole number from 1 to ${MAX_CANISTER_QTY.toLocaleString()}`,
+    );
+  if (!CANISTER_TYPES.some((t) => t === raw.type))
+    bad("Choose a canister type");
+  return { batch, expiry: raw.expiry, quantity: raw.quantity, type: raw.type };
+}
+
+export function formatCanister(c: CanisterInput): string {
+  return `Canister: Batch ${c.batch} · Exp ${c.expiry} · Qty ${c.quantity} · Type ${c.type}`;
+}
diff --git a/convex/lib/gs1.ts b/convex/lib/gs1.ts
new file mode 100644
index 0000000..2cb3801
--- /dev/null
+++ b/convex/lib/gs1.ts
@@ -0,0 +1,102 @@
+// Reads batch/lot and expiry out of a GS1 code printed on medicine boxes,
+// e.g. "(01)09312345678907(17)280909(10)50803-3" or the raw DataMatrix form
+// "0109312345678907172809091050803-3".
+
+const GS = String.fromCharCode(29);
+
+// Application identifiers with a fixed data length (digits after the AI)
+const FIXED: Record<string, number> = {
+  "00": 18,
+  "01": 14,
+  "02": 14,
+  "11": 6,
+  "12": 6,
+  "13": 6,
+  "15": 6,
+  "16": 6,
+  "17": 6,
+  "20": 2,
+};
+// Variable-length AIs that can appear on pharma packs (ended by GS or end of code)
+const VARIABLE_2 = new Set(["10", "21", "22", "30", "37", "90", "91", "92"]);
+const VARIABLE_3 = new Set([
+  "240",
+  "241",
+  "242",
+  "710",
+  "711",
+  "712",
+  "713",
+  "714",
+]);
+
+export type Gs1Data = { gtin?: string; batch?: string; expiry?: string };
+
+function toHalfWidth(text: string): string {
+  return text.replace(/[\uFF01-\uFF5E]/g, (c) =>
+    String.fromCharCode(c.charCodeAt(0) - 0xfee0),
+  );
+}
+
+// GS1 YYMMDD (DD may be 00 = end of month) → YYYY-MM-DD
+export function gs1DateToDay(yymmdd: string): string | undefined {
+  if (!/^\d{6}$/.test(yymmdd)) return undefined;
+  const year = 2000 + Number(yymmdd.slice(0, 2));
+  const month = Number(yymmdd.slice(2, 4));
+  let day = Number(yymmdd.slice(4, 6));
+  if (month < 1 || month > 12) return undefined;
+  const lastDay = new Date(Date.UTC(year, month, 0)).getUTCDate();
+  if (day === 0) day = lastDay;
+  if (day > lastDay) return undefined;
+  return `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
+}
+
+function parseBracketed(code: string): Record<string, string> {
+  const fields: Record<string, string> = {};
+  for (const m of code.matchAll(/\((\d{2,4})\)([^(]*)/g)) {
+    fields[m[1]] = m[2].replace(new RegExp(GS, "g"), "").trim();
+  }
+  return fields;
+}
+
+function parseRaw(code: string): Record<string, string> {
+  const fields: Record<string, string> = {};
+  let i = 0;
+  while (i < code.length) {
+    if (code[i] === GS) {
+      i++;
+      continue;
+    }
+    const ai2 = code.slice(i, i + 2);
+    const ai3 = code.slice(i, i + 3);
+    if (FIXED[ai2] !== undefined) {
+      fields[ai2] = code.slice(i + 2, i + 2 + FIXED[ai2]);
+      i += 2 + FIXED[ai2];
+    } else if (VARIABLE_2.has(ai2) || VARIABLE_3.has(ai3)) {
+      const ai = VARIABLE_2.has(ai2) ? ai2 : ai3;
+      const start = i + ai.length;
+      const end = code.indexOf(GS, start);
+      fields[ai] = code.slice(start, end === -1 ? undefined : end);
+      i = end === -1 ? code.length : end + 1;
+    } else {
+      break; // Unknown data: stop rather than guess
+    }
+  }
+  return fields;
+}
+
+export function parseGs1(raw: string): Gs1Data | null {
+  const code = toHalfWidth(raw)
+    .trim()
+    .replace(/^\][A-Za-z]\d/, "");
+  const bracketed = code.includes("(");
+  if (!(bracketed ? /\(01\)\d{14}/.test(code) : /^01\d{14}./.test(code)))
+    return null;
+  const fields = bracketed ? parseBracketed(code) : parseRaw(code);
+  const batch = fields["10"]?.trim();
+  return {
+    gtin: fields["01"],
+    batch: batch || undefined,
+    expiry: fields["17"] ? gs1DateToDay(fields["17"]) : undefined,
+  };
+}
