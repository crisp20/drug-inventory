@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+import type { PhotoMatch } from "../_hooks/use-photo-import.ts";
+import { applyKeepChoice, photosToUpload, splitMatches } from "./photo-choices.ts";
+
+function match(drugId: string, hasPhoto: boolean): PhotoMatch {
+  return {
+    drugId,
+    fileName: `${drugId}.jpg`,
+    file: new File([], `${drugId}.jpg`),
+    name: `Drug ${drugId}`,
+    hasPhoto,
+    photoUrl: hasPhoto ? `https://x/${drugId}` : null,
+  };
+}
+
+const matched = [match("1", false), match("2", true), match("3", true)];
+const { replacing } = splitMatches(matched);
+
+describe("photo upload choices", () => {
+  it("replaces every current picture by default", () => {
+    expect(photosToUpload(matched, new Set()).map((m) => m.drugId)).toEqual(["1", "2", "3"]);
+  });
+
+  it("leaves out replacements kept current, but always adds new pictures", () => {
+    expect(photosToUpload(matched, new Set(["1", "2"])).map((m) => m.drugId)).toEqual(["1", "3"]);
+  });
+
+  it("applies a bulk choice to the ticked ones only", () => {
+    const keep = applyKeepChoice(new Set(), replacing, new Set(["3"]), "keep");
+    expect([...keep]).toEqual(["3"]);
+    expect([...applyKeepChoice(keep, replacing, new Set(["3"]), "file")]).toEqual([]);
+  });
+
+  it("applies a bulk choice to every replacement when nothing is ticked", () => {
+    expect([...applyKeepChoice(new Set(), replacing, new Set(), "keep")].sort()).toEqual(["2", "3"]);
+  });
+});
diff --git a/src/pages/inventory/_lib/photo-choices.ts b/src/pages/inventory/_lib/photo-choices.ts
new file mode 100644
--- /dev/null
+++ b/src/pages/inventory/_lib/photo-choices.ts
@@ -0,0 +1,30 @@
+import type { PhotoMatch } from "../_hooks/use-photo-import.ts";
+
+// Splits matched photos into new pictures and replacements of a current picture
+export function splitMatches(matched: PhotoMatch[]) {
+  return {
+    adding: matched.filter((m) => !m.hasPhoto),
+    replacing: matched.filter((m) => m.hasPhoto),
+  };
+}
+
+// Photos to upload: every new picture, plus replacements the admin did not choose to keep
+export function photosToUpload(matched: PhotoMatch[], keep: ReadonlySet<string>): PhotoMatch[] {
+  return matched.filter((m) => !m.hasPhoto || !keep.has(m.drugId));
+}
+
+// Bulk choice: keep or replace the ticked Drug IDs, or every replacement when none are ticked
+export function applyKeepChoice(
+  keep: ReadonlySet<string>,
+  replacing: PhotoMatch[],
+  selected: ReadonlySet<string>,
+  choice: "keep" | "file",
+): Set<string> {
+  const targets = selected.size > 0 ? replacing.filter((m) => selected.has(m.drugId)) : replacing;
+  const next = new Set(keep);
+  for (const m of targets) {
+    if (choice === "keep") next.add(m.drugId);
+    else next.delete(m.drugId);
+  }
+  return next;
+}