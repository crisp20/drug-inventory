new file mode 100644
index 0000000..fe88514
--- /dev/null
+++ b/convex/lib/expiry.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, it } from "vitest";
+import {
+  cleanExpiryWarningMonths,
+  expiryStatus,
+  isExpiredOnServer,
+  warningUntil,
+} from "./expiry";
+import { cleanCanisterInput } from "./canister";
+
+describe("expiryStatus", () => {
+  const today = "2026-11-03";
+  it("treats dates before today as expired", () => {
+    expect(expiryStatus("2026-11-02", today, 1)).toBe("expired");
+    expect(expiryStatus("2025-12-04", today, 1)).toBe("expired");
+  });
+  it("lets stock be used on its expiry day, with a warning", () => {
+    expect(expiryStatus("2026-11-03", today, 1)).toBe("soon");
+  });
+  it("warns within the chosen months, inclusive", () => {
+    expect(expiryStatus("2026-12-03", today, 1)).toBe("soon");
+    expect(expiryStatus("2026-12-04", today, 1)).toBe("ok");
+    expect(expiryStatus("2027-02-01", today, 3)).toBe("soon");
+  });
+  it("never warns when set to 0, but still blocks expired", () => {
+    expect(expiryStatus("2026-11-04", today, 0)).toBe("ok");
+    expect(expiryStatus("2026-11-02", today, 0)).toBe("expired");
+  });
+  it("handles month ends", () => {
+    expect(warningUntil("2026-01-31", 1)).toBe("2026-02-28");
+  });
+});
+
+describe("expiry rules on the server", () => {
+  const now = new Date("2026-11-03T02:00:00Z");
+  it("allows a one-day grace for time zones ahead of UTC", () => {
+    expect(isExpiredOnServer("2026-11-02", now)).toBe(false);
+    expect(isExpiredOnServer("2026-11-01", now)).toBe(true);
+  });
+  it("refuses expired canister stock", () => {
+    expect(() =>
+      cleanCanisterInput({
+        batch: "B1",
+        expiry: "2020-01-01",
+        quantity: 10,
+        type: 1,
+      }),
+    ).toThrow(/expired/);
+  });
+  it("validates the warning months", () => {
+    expect(cleanExpiryWarningMonths(0)).toBe(0);
+    expect(cleanExpiryWarningMonths(6)).toBe(6);
+    for (const bad of [-1, 1.5, 25]) {
+      expect(() => cleanExpiryWarningMonths(bad)).toThrow();
+    }
+  });
+});
diff --git a/convex/lib/expiry.ts b/convex/lib/expiry.ts
new file mode 100644
index 0000000..6f215e3
--- /dev/null
+++ b/convex/lib/expiry.ts
@@ -0,0 +1,53 @@
+import { addMonths, format, parseISO, subDays } from "date-fns";
+import { ConvexError } from "convex/values";
+
+// Canister stock expiring within this many months asks the user to confirm
+export const DEFAULT_EXPIRY_WARNING_MONTHS = 1;
+export const MAX_EXPIRY_WARNING_MONTHS = 24;
+
+export type ExpiryStatus = "expired" | "soon" | "ok";
+
+const DAY_FORMAT = "yyyy-MM-dd";
+
+// Today's calendar day (YYYY-MM-DD) in the given date's local time zone
+export function toCalendarDay(date: Date): string {
+  return format(date, DAY_FORMAT);
+}
+
+// Last calendar day still counted as "expiring soon"
+export function warningUntil(today: string, months: number): string {
+  return toCalendarDay(addMonths(parseISO(today), months));
+}
+
+// Days are YYYY-MM-DD, so plain string comparison orders them correctly.
+// Stock is still usable on its expiry day itself.
+export function expiryStatus(
+  expiry: string,
+  today: string,
+  months: number,
+): ExpiryStatus {
+  if (expiry < today) return "expired";
+  if (months > 0 && expiry <= warningUntil(today, months)) return "soon";
+  return "ok";
+}
+
+export function cleanExpiryWarningMonths(value: number): number {
+  if (
+    !Number.isInteger(value) ||
+    value < 0 ||
+    value > MAX_EXPIRY_WARNING_MONTHS
+  ) {
+    throw new ConvexError({
+      code: "BAD_REQUEST",
+      message: `Enter a whole number of months from 0 to ${MAX_EXPIRY_WARNING_MONTHS}`,
+    });
+  }
+  return value;
+}
+
+// The server only knows UTC, while the user picks dates in their own time zone
+// (up to a day ahead of UTC), so it allows yesterday's UTC date as well.
+export function isExpiredOnServer(expiry: string, now: Date): boolean {
+  const earliest = subDays(now, 1).toISOString().slice(0, 10);
+  return expiry < earliest;
+}
